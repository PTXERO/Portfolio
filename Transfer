  // Graph state
  let scNodes  = [];  // [{id, type, x, y, enabled, params, selectVal, audioNode}]
  let scEdges  = [];  // [{fromId, fromPort, toId, toPort}]
  let scBypassAllState = false;
  let pendingPort = null; // {nodeId, port, isOut, el, x, y}

  // Fixed node IDs
  const SC_SOURCE_ID = '__source__';
  const SC_OUTPUT_ID = '__output__';

  function hexToRgbSc(hex){
    return `${parseInt(hex.slice(1,3),16)},${parseInt(hex.slice(3,5),16)},${parseInt(hex.slice(5,7),16)}`;
  }

  // ── Web Audio node factories ──────────────────────────────────
  function makeModLFO(rate, depth){
    const lfo=audioCtx.createOscillator(); lfo.frequency.value=rate;
    const lfoGain=audioCtx.createGain(); lfoGain.gain.value=depth;
    lfo.connect(lfoGain); lfo.start();
    return {lfo,lfoGain};
  }
  function makeWetDry(wet){
    const w=audioCtx.createGain(); w.gain.value=wet;
    const d=audioCtx.createGain(); d.gain.value=1-wet;
    return {wet:w,dry:d};
  }

  function makeWebAudioNode(type, params, selectVal){
    if(!audioCtx) return null;
    try {
      // ── Utility ──
      if(type==='gain'){
        const n=audioCtx.createGain(); n.gain.value=params.gain??1;
        return {input:n,output:n,nodes:[n]};
      }
      if(type==='panner'){
        const n=audioCtx.createStereoPanner(); n.pan.value=params.pan??0;
        return {input:n,output:n,nodes:[n]};
      }
      if(type==='clone'){
        const inp=audioCtx.createGain();
        const gainA=audioCtx.createGain(); gainA.gain.value=params.gainA??1;
        const gainB=audioCtx.createGain(); gainB.gain.value=params.gainB??1;
        inp.connect(gainA); inp.connect(gainB);
        return {input:inp,output:gainA,outputA:gainA,outputB:gainB,nodes:[inp,gainA,gainB],gainA,gainB};
      }
      // ── Dynamics ──
      if(type==='compressor'){
        const n=audioCtx.createDynamicsCompressor();
        n.threshold.value=params.threshold??-24; n.ratio.value=params.ratio??4;
        n.attack.value=params.attack??0.01; n.release.value=params.release??0.25;
        return {input:n,output:n,nodes:[n]};
      }
      if(type==='limiter'){
        const n=audioCtx.createDynamicsCompressor();
        n.threshold.value=params.threshold??-1; n.ratio.value=20;
        n.attack.value=0.001; n.release.value=params.release??0.1; n.knee.value=0;
        return {input:n,output:n,nodes:[n]};
      }
      if(type==='gate'){
        // Noise gate via compressor with extreme ratio
        const n=audioCtx.createDynamicsCompressor();
        n.threshold.value=params.threshold??-40; n.ratio.value=20;
        n.attack.value=params.attack??0.01; n.release.value=params.release??0.2;
        n.knee.value=0;
        return {input:n,output:n,nodes:[n]};
      }
      // ── Filter ──
      if(type==='filter'){
        const n=audioCtx.createBiquadFilter();
        n.type=selectVal||'lowpass'; n.frequency.value=params.freq??2000; n.Q.value=params.q??1;
        return {input:n,output:n,nodes:[n]};
      }
      if(type==='eq'){
        const lo=audioCtx.createBiquadFilter(); lo.type='lowshelf';  lo.frequency.value=200;  lo.gain.value=params.low??0;
        const mi=audioCtx.createBiquadFilter(); mi.type='peaking';   mi.frequency.value=1000; mi.gain.value=params.mid??0; mi.Q.value=1;
        const hi=audioCtx.createBiquadFilter(); hi.type='highshelf'; hi.frequency.value=4000; hi.gain.value=params.high??0;
        lo.connect(mi); mi.connect(hi);
        return {input:lo,output:hi,nodes:[lo,mi,hi]};
      }
      if(type==='wah'){
        const f=audioCtx.createBiquadFilter(); f.type='bandpass'; f.frequency.value=params.freq??800; f.Q.value=params.q??8;
        const {wet,dry}=makeWetDry(params.wet??0.8);
        const inp=audioCtx.createGain(),out=audioCtx.createGain();
        inp.connect(dry); dry.connect(out); inp.connect(f); f.connect(wet); wet.connect(out);
        return {input:inp,output:out,nodes:[inp,out,f,wet,dry],f,wet,dry};
      }
      if(type==='combfilter'){
        const dly=audioCtx.createDelay(0.1); dly.delayTime.value=1/(params.freq??200);
        const fb=audioCtx.createGain(); fb.gain.value=params.fb??0.5;
        const {wet,dry}=makeWetDry(params.wet??0.5);
        const inp=audioCtx.createGain(),out=audioCtx.createGain();
        inp.connect(dry); dry.connect(out);
        inp.connect(dly); dly.connect(fb); fb.connect(dly); dly.connect(wet); wet.connect(out);
        return {input:inp,output:out,nodes:[inp,out,dly,fb,wet,dry],dly,fb,wet,dry};
      }
      // ── Drive ──
      function makeWaveShaper(amount, type='hard'){
        const sz=512; const curve=new Float32Array(sz);
        for(let i=0;i<sz;i++){
          const x=i*2/sz-1;
          if(type==='soft') curve[i]=Math.tanh(amount*3*x);
          else { const k=amount*200+1; curve[i]=(Math.PI+k)*x/(Math.PI+k*Math.abs(x)); }
        }
        return curve;
      }
      if(type==='distortion'){
        const ws=audioCtx.createWaveShaper();
        ws.curve=makeWaveShaper(params.drive??0.3,'hard'); ws.oversample='4x';
        const tone=audioCtx.createBiquadFilter(); tone.type='lowpass'; tone.frequency.value=params.tone??2000;
        ws.connect(tone);
        return {input:ws,output:tone,nodes:[ws,tone],ws,tone};
      }
      if(type==='overdrive'){
        const ws=audioCtx.createWaveShaper();
        ws.curve=makeWaveShaper(params.drive??0.3,'soft'); ws.oversample='4x';
        const tone=audioCtx.createBiquadFilter(); tone.type='lowpass';
        tone.frequency.value=500+params.tone*3500??2000;
        const lvl=audioCtx.createGain(); lvl.gain.value=params.level??1;
        ws.connect(tone); tone.connect(lvl);
        return {input:ws,output:lvl,nodes:[ws,tone,lvl],ws,tone,lvl};
      }
      if(type==='fuzz'){
        const ws=audioCtx.createWaveShaper();
        const fuzz=params.fuzz??0.7; const sz=512; const curve=new Float32Array(sz);
        for(let i=0;i<sz;i++){ const x=i*2/sz-1; curve[i]=x<0?-1:1; } // hard clip
        ws.curve=curve; ws.oversample='4x';
        const lvl=audioCtx.createGain(); lvl.gain.value=(params.level??1)*(1-fuzz*0.5);
        ws.connect(lvl);
        return {input:ws,output:lvl,nodes:[ws,lvl],ws,lvl};
      }
      if(type==='bitcrusher'){
        // Bitcrusher via script processor (fallback to waveshaper approximation)
        const bits=Math.round(params.bits??8);
        const rate=params.rate??1;
        const step=Math.pow(2,-(bits-1));
        const ws=audioCtx.createWaveShaper();
        const sz=4096; const curve=new Float32Array(sz);
        for(let i=0;i<sz;i++){
          const x=i*2/sz-1;
          curve[i]=Math.round(x/step)*step;
        }
        ws.curve=curve; ws.oversample='none';
        return {input:ws,output:ws,nodes:[ws],ws};
      }
      // ── Modulation ──
      if(type==='chorus'){
        const dly=audioCtx.createDelay(0.05); dly.delayTime.value=0.025;
        const {lfo,lfoGain}=makeModLFO(params.rate??1.5, params.depth??0.005);
        lfoGain.connect(dly.delayTime);
        const {wet,dry}=makeWetDry(params.wet??0.5);
        const inp=audioCtx.createGain(),out=audioCtx.createGain();
        inp.connect(dry); dry.connect(out); inp.connect(dly); dly.connect(wet); wet.connect(out);
        return {input:inp,output:out,nodes:[inp,out,dly,wet,dry,lfo,lfoGain],dly,wet,dry,lfo,lfoGain};
      }
      if(type==='flanger'){
        const dly=audioCtx.createDelay(0.02); dly.delayTime.value=0.005;
        const fb=audioCtx.createGain(); fb.gain.value=params.fb??0.5;
        const {lfo,lfoGain}=makeModLFO(params.rate??0.3, params.depth??0.003);
        lfoGain.connect(dly.delayTime); dly.connect(fb); fb.connect(dly);
        const {wet,dry}=makeWetDry(params.wet??0.5);
        const inp=audioCtx.createGain(),out=audioCtx.createGain();
        inp.connect(dry); dry.connect(out); inp.connect(dly); dly.connect(wet); wet.connect(out);
        return {input:inp,output:out,nodes:[inp,out,dly,fb,wet,dry,lfo,lfoGain],dly,fb,wet,dry,lfo,lfoGain};
      }
      if(type==='phaser'){
        // 4-stage allpass phaser
        const stages=[];
        for(let i=0;i<4;i++){
          const ap=audioCtx.createBiquadFilter(); ap.type='allpass'; ap.frequency.value=400*(i+1); ap.Q.value=10;
          stages.push(ap);
        }
        stages.reduce((a,b)=>{a.connect(b);return b;});
        const {lfo,lfoGain}=makeModLFO(params.rate??1, params.depth??0.8);
        stages.forEach(s=>lfoGain.connect(s.frequency));
        const {wet,dry}=makeWetDry(params.wet??0.5);
        const inp=audioCtx.createGain(),out=audioCtx.createGain();
        inp.connect(dry); dry.connect(out); inp.connect(stages[0]); stages[stages.length-1].connect(wet); wet.connect(out);
        return {input:inp,output:out,nodes:[inp,out,...stages,wet,dry,lfo,lfoGain],stages,wet,dry,lfo,lfoGain};
      }
      if(type==='tremolo'){
        const gain=audioCtx.createGain(); gain.gain.value=1;
        const {lfo,lfoGain}=makeModLFO(params.rate??4, (params.depth??0.7)*0.5);
        const dc=audioCtx.createConstantSource(); dc.offset.value=1-(params.depth??0.7)*0.5;
        const mix=audioCtx.createGain(); mix.gain.value=1;
        lfoGain.connect(gain.gain); dc.connect(gain.gain); dc.start();
        return {input:gain,output:gain,nodes:[gain,lfo,lfoGain,dc],lfo,lfoGain,dc,gain};
      }
      if(type==='vibrato'){
        const dly=audioCtx.createDelay(0.02); dly.delayTime.value=0.01;
        const {lfo,lfoGain}=makeModLFO(params.rate??5, params.depth??0.005);
        lfoGain.connect(dly.delayTime);
        return {input:dly,output:dly,nodes:[dly,lfo,lfoGain],dly,lfo,lfoGain};
      }
      if(type==='ringmod'){
        const osc=audioCtx.createOscillator(); osc.frequency.value=params.freq??100; osc.start();
        const ring=audioCtx.createGain(); ring.gain.value=0;
        osc.connect(ring.gain);
        const {wet,dry}=makeWetDry(params.wet??0.5);
        const inp=audioCtx.createGain(),out=audioCtx.createGain();
        inp.connect(dry); dry.connect(out); inp.connect(ring); ring.connect(wet); wet.connect(out);
        return {input:inp,output:out,nodes:[inp,out,ring,wet,dry,osc],osc,ring,wet,dry};
      }
      if(type==='autopan'){
        const pan=audioCtx.createStereoPanner(); pan.pan.value=0;
        const {lfo,lfoGain}=makeModLFO(params.rate??1, params.depth??0.8);
        lfoGain.connect(pan.pan);
        return {input:pan,output:pan,nodes:[pan,lfo,lfoGain],pan,lfo,lfoGain};
      }
      // ── Time ──
      if(type==='reverb'){
        const {wet,dry}=makeWetDry(params.wet??0.3);
        const conv=audioCtx.createConvolver();
        const decay=params.decay??2;
        const buf=audioCtx.createBuffer(2,audioCtx.sampleRate*Math.min(decay,8),audioCtx.sampleRate);
        for(let ch=0;ch<2;ch++){const d=buf.getChannelData(ch);for(let i=0;i<buf.length;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/buf.length,1.5);}
        conv.buffer=buf;
        const inp=audioCtx.createGain(),out=audioCtx.createGain();
        inp.connect(dry); dry.connect(out); inp.connect(conv); conv.connect(wet); wet.connect(out);
        return {input:inp,output:out,nodes:[inp,out,wet,dry,conv],wet,dry,conv};
      }
      if(type==='delay'){
        const dly=audioCtx.createDelay(2); dly.delayTime.value=params.time??0.25;
        const fb=audioCtx.createGain(); fb.gain.value=params.feedback??0.3;
        const {wet,dry}=makeWetDry(params.wet??0.3);
        const inp=audioCtx.createGain(),out=audioCtx.createGain();
        inp.connect(dry); dry.connect(out); inp.connect(dly); dly.connect(wet); wet.connect(out); dly.connect(fb); fb.connect(dly);
        return {input:inp,output:out,nodes:[inp,out,dly,fb,wet,dry],dly,fb,wet,dry};
      }
      if(type==='pingpong'){
        const dlyL=audioCtx.createDelay(2); dlyL.delayTime.value=params.time??0.25;
        const dlyR=audioCtx.createDelay(2); dlyR.delayTime.value=(params.time??0.25)*1.5;
        const fb=audioCtx.createGain(); fb.gain.value=params.feedback??0.4;
        const panL=audioCtx.createStereoPanner(); panL.pan.value=-1;
        const panR=audioCtx.createStereoPanner(); panR.pan.value=1;
        const {wet,dry}=makeWetDry(params.wet??0.4);
        const inp=audioCtx.createGain(),out=audioCtx.createGain();
        inp.connect(dry); dry.connect(out);
        inp.connect(dlyL); dlyL.connect(panL); panL.connect(wet); wet.connect(out);
        dlyL.connect(fb); fb.connect(dlyR); dlyR.connect(panR); panR.connect(wet);
        return {input:inp,output:out,nodes:[inp,out,dlyL,dlyR,fb,panL,panR,wet,dry],dlyL,dlyR,fb,wet,dry};
      }
      // ── Spatial ──
      if(type==='widener'){
        // Mid-side widener
        const inp=audioCtx.createGain(),out=audioCtx.createGain();
        const split=audioCtx.createChannelSplitter(2);
        const merge=audioCtx.createChannelMerger(2);
        const gL=audioCtx.createGain(); const gR=audioCtx.createGain();
        const width=params.width??1;
        gL.gain.value=width; gR.gain.value=width;
        inp.connect(split);
        split.connect(gL,0); split.connect(gR,1);
        gL.connect(merge,0,0); gR.connect(merge,0,1);
        merge.connect(out);
        return {input:inp,output:out,nodes:[inp,out,split,merge,gL,gR],gL,gR};
      }
      // ── Synth ──
      if(type==='oscillator'){
        const osc=audioCtx.createOscillator(); osc.type=selectVal||'sine'; osc.frequency.value=params.freq??440;
        const lvl=audioCtx.createGain(); lvl.gain.value=params.level??0.3;
        const inp=audioCtx.createGain(); // pass-through for input
        osc.connect(lvl); osc.start();
        // Mix oscillator with input
        const mix=audioCtx.createGain();
        inp.connect(mix); lvl.connect(mix);
        return {input:inp,output:mix,nodes:[inp,mix,osc,lvl],osc,lvl};
      }
      if(type==='noisegen'){
        const bufSz=audioCtx.sampleRate*2;
        const buf=audioCtx.createBuffer(1,bufSz,audioCtx.sampleRate);
        const d=buf.getChannelData(0); for(let i=0;i<bufSz;i++) d[i]=Math.random()*2-1;
        const src=audioCtx.createBufferSource(); src.buffer=buf; src.loop=true; src.start();
        const f=audioCtx.createBiquadFilter(); f.type='bandpass'; f.frequency.value=params.freq??3000; f.Q.value=0.5;
        const lvl=audioCtx.createGain(); lvl.gain.value=params.level??0.3;
        src.connect(f); f.connect(lvl);
        const inp=audioCtx.createGain();
        const mix=audioCtx.createGain();
        inp.connect(mix); lvl.connect(mix);
        return {input:inp,output:mix,nodes:[inp,mix,src,f,lvl],src,f,lvl};
      }
      if(type==='pitchshift'){
        // Approximate pitch shift via playback rate on buffer (simple version)
        const inp=audioCtx.createGain(),out=audioCtx.createGain();
        const semi=params.semitones??0;
        const {wet,dry}=makeWetDry(params.wet??0.5);
        // Without AudioWorklet, use a detune on a biquad as a placeholder
        const det=audioCtx.createBiquadFilter(); det.type='allpass'; det.detune=semi*100;
        inp.connect(dry); dry.connect(out); inp.connect(det); det.connect(wet); wet.connect(out);
        return {input:inp,output:out,nodes:[inp,out,det,wet,dry],det,wet,dry};
      }
    } catch(e){ console.warn('SC node error',type,e); }
    return null;
  }

  function updateNodeParams(node){
    if(!node.audioNode||!audioCtx) return;
    const p=node.params; const n=node.audioNode;
    try {
      if(node.type==='gain') n.nodes[0].gain.value=p.gain??1;
      if(node.type==='panner') n.nodes[0].pan.value=p.pan??0;
      if(node.type==='clone'){ n.gainA.gain.value=p.gainA??1; n.gainB.gain.value=p.gainB??1; }
      if(node.type==='compressor'||node.type==='limiter'||node.type==='gate'){
        n.nodes[0].threshold.value=p.threshold??-24;
        if(p.ratio!==undefined) n.nodes[0].ratio.value=p.ratio;
        if(p.attack!==undefined) n.nodes[0].attack.value=p.attack;
        if(p.release!==undefined) n.nodes[0].release.value=p.release;
      }
      if(node.type==='filter'){ n.nodes[0].frequency.value=p.freq??2000; n.nodes[0].Q.value=p.q??1; n.nodes[0].type=node.selectVal||'lowpass'; }
      if(node.type==='eq'){ n.nodes[0].gain.value=p.low??0; n.nodes[1].gain.value=p.mid??0; n.nodes[2].gain.value=p.high??0; }
      if(node.type==='wah'){ n.f.frequency.value=p.freq??800; n.f.Q.value=p.q??8; n.wet.gain.value=p.wet??0.8; n.dry.gain.value=1-(p.wet??0.8); }
      if(node.type==='combfilter'){ n.dly.delayTime.value=1/(p.freq??200); n.fb.gain.value=p.fb??0.5; n.wet.gain.value=p.wet??0.5; n.dry.gain.value=1-(p.wet??0.5); }
      if(node.type==='distortion'){
        const k=(p.drive??0.3)*100+1; const sz=256; const curve=new Float32Array(sz);
        for(let i=0;i<sz;i++){const x=i*2/sz-1;curve[i]=(Math.PI+k)*x/(Math.PI+k*Math.abs(x));}
        n.ws.curve=curve; n.tone.frequency.value=p.tone??2000;
      }
      if(node.type==='overdrive'){ n.lvl.gain.value=p.level??1; n.tone.frequency.value=500+(p.tone??0.5)*3500; }
      if(node.type==='fuzz'){ n.lvl.gain.value=(p.level??1)*(1-(p.fuzz??0.7)*0.5); }
      if(node.type==='reverb'){ n.wet.gain.value=p.wet??0.3; n.dry.gain.value=1-(p.wet??0.3); }
      if(node.type==='delay'){ n.dly.delayTime.value=p.time??0.25; n.fb.gain.value=p.feedback??0.3; n.wet.gain.value=p.wet??0.3; n.dry.gain.value=1-(p.wet??0.3); }
      if(node.type==='pingpong'){ n.dlyL.delayTime.value=p.time??0.25; n.dlyR.delayTime.value=(p.time??0.25)*1.5; n.fb.gain.value=p.feedback??0.4; n.wet.gain.value=p.wet??0.4; n.dry.gain.value=1-(p.wet??0.4); }
      if(node.type==='chorus'||node.type==='flanger'){ n.lfo.frequency.value=p.rate??1.5; n.lfoGain.gain.value=p.depth??0.005; n.wet.gain.value=p.wet??0.5; n.dry.gain.value=1-(p.wet??0.5); }
      if(node.type==='phaser'){ n.lfo.frequency.value=p.rate??1; n.lfoGain.gain.value=p.depth??0.8; n.wet.gain.value=p.wet??0.5; n.dry.gain.value=1-(p.wet??0.5); }
      if(node.type==='tremolo'){ n.lfo.frequency.value=p.rate??4; n.lfoGain.gain.value=(p.depth??0.7)*0.5; }
      if(node.type==='vibrato'){ n.lfo.frequency.value=p.rate??5; n.lfoGain.gain.value=p.depth??0.005; }
      if(node.type==='ringmod'){ n.osc.frequency.value=p.freq??100; n.wet.gain.value=p.wet??0.5; n.dry.gain.value=1-(p.wet??0.5); }
      if(node.type==='autopan'){ n.lfo.frequency.value=p.rate??1; n.lfoGain.gain.value=p.depth??0.8; }
      if(node.type==='widener'){ n.gL.gain.value=p.width??1; n.gR.gain.value=p.width??1; }
      if(node.type==='oscillator'){ n.osc.frequency.value=p.freq??440; n.lvl.gain.value=p.level??0.3; if(node.selectVal) n.osc.type=node.selectVal; }
      if(node.type==='noisegen'){ n.f.frequency.value=p.freq??3000; n.lvl.gain.value=p.level??0.3; }
      if(node.type==='pitchshift'){ n.det.detune=( p.semitones??0)*100; n.wet.gain.value=p.wet??0.5; n.dry.gain.value=1-(p.wet??0.5); }
    } catch(e){}
  }

  // ── Audio graph rebuild from edge connections ─────────────────
  function rebuildAudioChain(){
    if(!audioCtx||!streamGain||!masterGain) return;

    // Disconnect only outputs — never inputs (would break internal module routing)
    // and never masterGain downstream
    try{ streamGain.disconnect(); }catch(e){}
    scNodes.forEach(n=>{ if(n.audioNode){
      try{ n.audioNode.output.disconnect(); }catch(e){}
      try{ n.audioNode.outputA?.disconnect(); }catch(e){}
      try{ n.audioNode.outputB?.disconnect(); }catch(e){}
    }});

    // Bypass all or no edges — direct pass
    if(scBypassAllState || !scEdges.length){
      streamGain.connect(masterGain);
      return;
    }

    // Connect each edge
    scEdges.forEach(e=>{
      let fromAudio;
      if(e.fromId===SC_SOURCE_ID){
        fromAudio = { output:streamGain, outputA:streamGain, outputB:streamGain };
      } else {
        const fromNode = scNodes.find(n=>n.id===e.fromId);
        if(!fromNode?.audioNode) return;
        if(!fromNode.enabled){
          // Bypassed — signal passes through untouched (use input node as source)
          fromAudio = { output:fromNode.audioNode.input, outputA:fromNode.audioNode.input, outputB:fromNode.audioNode.input };
        } else {
          fromAudio = fromNode.audioNode;
        }
      }

      let toInput;
      if(e.toId===SC_OUTPUT_ID){
        toInput = masterGain;
      } else {
        const toNode = scNodes.find(n=>n.id===e.toId);
        if(!toNode?.audioNode) return;
        toInput = toNode.enabled ? toNode.audioNode.input : toNode.audioNode.input;
      }

      try{
        let outNode;
        if(e.fromPort==='OUT A')      outNode = fromAudio.outputA || fromAudio.output;
        else if(e.fromPort==='OUT B') outNode = fromAudio.outputB || fromAudio.output;
        else                          outNode = fromAudio.output;
        outNode.connect(toInput);
      }catch(ex){ console.warn('SC connect failed', e.fromId, '->', e.toId, ex); }
    });

    // If nothing reaches OUTPUT node, fall back to direct
    if(!scEdges.some(e=>e.toId===SC_OUTPUT_ID)){
      streamGain.connect(masterGain);
    }
  }

  // ── Canvas cable drawing ──────────────────────────────────────
  let scCanvas, scCanvasCtx;

  function initScCanvas(){
    scCanvas = document.getElementById('scGraphCanvas');
    scCanvasCtx = scCanvas.getContext('2d');
    const body = document.getElementById('scBody');
    const r = body.getBoundingClientRect();
    scCanvas.width  = r.width;
    scCanvas.height = r.height;
  }

  function getPortCenter(nodeId, portName, isOut){
    // Find the port DOM element and get its center relative to scBody
    const body = document.getElementById('scBody');
    const bodyRect = body.getBoundingClientRect();
    const ports = body.querySelectorAll('.sc-port[data-node="'+nodeId+'"][data-port="'+portName+'"]');
    for(const p of ports){
      if(isOut && p.classList.contains('sc-port-out-dot')) continue;
      const r = p.getBoundingClientRect();
      return { x: r.left-bodyRect.left+r.width/2, y: r.top-bodyRect.top+r.height/2 };
    }
    return null;
  }

  function drawCables(){
    if(!scCanvas||!scCanvasCtx) return;
    const body = document.getElementById('scBody');
    const W=scCanvas.width, H=scCanvas.height;
    scCanvasCtx.clearRect(0,0,W,H);

    scEdges.forEach((e,i)=>{
      const fromPos = getPortPos(e.fromId, e.fromPort, true);
      const toPos   = getPortPos(e.toId,   e.toPort,   false);
      if(!fromPos||!toPos) return;
      const def = e.fromId===SC_SOURCE_ID ? null : MODULE_DEFS[scNodes.find(n=>n.id===e.fromId)?.type];
      const color = def ? def.color : '#42d4f5';
      const isHovered = false;
      const cp1x = fromPos.x + Math.abs(toPos.x-fromPos.x)*0.5;
      const cp2x = toPos.x   - Math.abs(toPos.x-fromPos.x)*0.5;
      scCanvasCtx.beginPath();
      scCanvasCtx.moveTo(fromPos.x, fromPos.y);
      scCanvasCtx.bezierCurveTo(cp1x, fromPos.y, cp2x, toPos.y, toPos.x, toPos.y);
      scCanvasCtx.strokeStyle = isHovered ? 'rgba(245,66,66,0.9)' : `rgba(${hexToRgbSc(color)},0.65)`;
      scCanvasCtx.lineWidth = isHovered ? 3 : 2;
      scCanvasCtx.shadowColor = isHovered ? '#f54242' : color;
      scCanvasCtx.shadowBlur = isHovered ? 8 : 4;
      scCanvasCtx.stroke();
      scCanvasCtx.shadowBlur = 0;
      // Show ✕ label at midpoint of hovered cable
      if(isHovered){
        const mt=0.5;
        const mx2=Math.pow(1-mt,3)*fromPos.x+3*Math.pow(1-mt,2)*mt*cp1x+3*(1-mt)*mt*mt*cp2x+mt*mt*mt*toPos.x;
        const my2=Math.pow(1-mt,3)*fromPos.y+3*Math.pow(1-mt,2)*mt*fromPos.y+3*(1-mt)*mt*mt*toPos.y+mt*mt*mt*toPos.y;
        scCanvasCtx.font='bold 11px monospace';
        scCanvasCtx.fillStyle='rgba(245,66,66,0.9)';
        scCanvasCtx.fillText('✕',mx2-5,my2+4);
      }
    });

    // Command edges — dashed green
    cmdEdges.forEach(e=>{
      const fp = getPortPos(e.fromId, e.fromPort, true);
      const tp = getPortPos(e.toId,   e.toPort,   false);
      if(!fp||!tp) return;
      scCanvasCtx.beginPath();
      scCanvasCtx.moveTo(fp.x,fp.y);
      const cp1x=fp.x+Math.abs(tp.x-fp.x)*0.5;
      const cp2x=tp.x-Math.abs(tp.x-fp.x)*0.5;
      scCanvasCtx.bezierCurveTo(cp1x,fp.y,cp2x,tp.y,tp.x,tp.y);
      scCanvasCtx.strokeStyle='rgba(0,255,80,0.5)';
      scCanvasCtx.lineWidth=1.5;
      scCanvasCtx.setLineDash([5,4]);
      scCanvasCtx.shadowColor='#00ff50';
      scCanvasCtx.shadowBlur=3;
      scCanvasCtx.stroke();
      scCanvasCtx.setLineDash([]);
      scCanvasCtx.shadowBlur=0;
    });

    // Ctrl edges — cmd OUT → knob MOD (thin dashed green)
    ctrlEdges.forEach(e=>{
      const fp=getPortPos(e.fromId,'OUT',true);
      const tp=getKnobPortPos(e.toNodeId,e.toKnobId);
      if(!fp||!tp) return;
      const fx=fp.x,fy=fp.y,tx=tp.x,ty=tp.y;
      {
      scCanvasCtx.beginPath();
      scCanvasCtx.moveTo(fx,fy);
      scCanvasCtx.bezierCurveTo(fx+Math.abs(tx-fx)*0.5,fy,tx-Math.abs(tx-fx)*0.5,ty,tx,ty);
      scCanvasCtx.strokeStyle='rgba(0,255,80,0.45)';
      scCanvasCtx.lineWidth=1;
      scCanvasCtx.setLineDash([3,3]);
      scCanvasCtx.shadowColor='#00ff50';
      scCanvasCtx.shadowBlur=2;
      scCanvasCtx.stroke();
      scCanvasCtx.setLineDash([]);
      scCanvasCtx.shadowBlur=0;
      }
    });

    // Pending cable from active port — draw from actual port position
    if(pendingPort && scDragCablePos){
      const isGreen = pendingPort.isCmd || pendingPort.isKnob;
      const portPos = pendingPort.isKnob
        ? getKnobPortPos(pendingPort.nodeId, pendingPort.knobId)
        : getPortPos(pendingPort.nodeId, pendingPort.portName, pendingPort.isOut);
      if(portPos){
        const mx=scDragCablePos.x, my=scDragCablePos.y;
        const cp1x = pendingPort.isOut ? portPos.x+60 : mx+60;
        const cp2x = pendingPort.isOut ? mx-60 : portPos.x-60;
        scCanvasCtx.beginPath();
        scCanvasCtx.moveTo(portPos.x, portPos.y);
        scCanvasCtx.bezierCurveTo(cp1x, portPos.y, cp2x, my, mx, my);
        scCanvasCtx.strokeStyle = isGreen ? 'rgba(0,255,80,0.7)' : 'rgba(66,212,245,0.7)';
        scCanvasCtx.lineWidth = 2;
        scCanvasCtx.shadowColor = isGreen ? '#00ff50' : '#42d4f5';
        scCanvasCtx.shadowBlur = 6;
        scCanvasCtx.setLineDash([5,4]);
        scCanvasCtx.stroke();
        scCanvasCtx.setLineDash([]);
        scCanvasCtx.shadowBlur = 0;
        scCanvasCtx.beginPath();
        scCanvasCtx.arc(mx,my,4,0,Math.PI*2);
        scCanvasCtx.fillStyle=isGreen?'rgba(0,255,80,0.8)':'rgba(66,212,245,0.8)';
        scCanvasCtx.fill();
      }
    }
  }

  function updatePortConnectedStates(){
    document.querySelectorAll('.sc-port').forEach(p=>p.classList.remove('connected'));
    document.querySelectorAll('.sc-sqport').forEach(p=>p.classList.remove('connected'));
    scEdges.forEach(e=>{
      const fp=document.querySelector(`.sc-port[data-node="${e.fromId}"][data-port="${e.fromPort}"]`);
      const tp=document.querySelector(`.sc-port[data-node="${e.toId}"][data-port="${e.toPort}"]`);
      if(fp) fp.classList.add('connected');
      if(tp) tp.classList.add('connected');
    });
    cmdEdges.forEach(e=>{
      const fp=document.querySelector(`.sc-sqport[data-node="${e.fromId}"][data-port="${e.fromPort}"]`);
      const tp=document.querySelector(`.sc-sqport[data-node="${e.toId}"][data-port="${e.toPort}"]`);
      if(fp) fp.classList.add('connected');
      if(tp) tp.classList.add('connected');
    });
    ctrlEdges.forEach(e=>{
      const fp=document.querySelector(`.sc-sqport[data-node="${e.fromId}"][data-port="OUT"]`);
      const tp=document.querySelector(`.sc-knob-sqport[data-node="${e.toNodeId}"][data-knob="${e.toKnobId}"]`);
      if(fp) fp.classList.add('connected');
      if(tp) tp.classList.add('connected');
    });
  }

  function getPortPos(nodeId, portName, isOut){
    const body = document.getElementById('scBody');
    if(!body) return null;
    const bodyRect = body.getBoundingClientRect();
    const el = body.querySelector(`.sc-port[data-node="${nodeId}"][data-port="${portName}"]`)
            || body.querySelector(`.sc-sqport[data-node="${nodeId}"][data-port="${portName}"]`);
    if(!el) return null;
    const r = el.getBoundingClientRect();
    return { x: r.left-bodyRect.left+r.width/2, y: r.top-bodyRect.top+r.height/2 };
  }
  function getKnobPortPos(nodeId, knobId){
    const body = document.getElementById('scBody');
    if(!body) return null;
    const el = body.querySelector(`.sc-knob-sqport[data-node="${nodeId}"][data-knob="${knobId}"]`);
    if(!el) return null;
    const br = body.getBoundingClientRect(), r = el.getBoundingClientRect();
    return { x: r.left-br.left+r.width/2, y: r.top-br.top+r.height/2 };
  }

  let scDragCablePos = null;

  // ── Knob rendering ────────────────────────────────────────────
  function scKnobAngle(val, kd){
    let norm;
    if(kd.log){
      const lo=Math.log(Math.max(kd.min,0.0001)), hi=Math.log(kd.max);
      norm=(Math.log(Math.max(val,0.0001))-lo)/(hi-lo);
    } else { norm=(val-kd.min)/(kd.max-kd.min); }
    return -135+Math.max(0,Math.min(1,norm))*270;
  }

  function renderScKnob(kd, val, color){
    const ang=scKnobAngle(val,kd);
    const acc=hexToRgbSc(color);
    const arcLen=((ang+135)/270)*125.66;
    return `<svg width="36" height="36" viewBox="0 0 36 36">
      <circle cx="18" cy="18" r="13" fill="none" stroke="rgba(40,40,47,1)" stroke-width="3"/>
      <circle cx="18" cy="18" r="13" fill="none" stroke="rgba(${acc},0.3)" stroke-width="3"
        stroke-dasharray="${arcLen} 125.66" transform="rotate(-225 18 18)" stroke-linecap="round"/>
      <circle cx="18" cy="18" r="10" fill="#0d0d12" stroke="rgba(${acc},0.3)" stroke-width="1"/>
      <line x1="18" y1="18" x2="${(18+8*Math.cos((ang-90)*Math.PI/180)).toFixed(1)}" y2="${(18+8*Math.sin((ang-90)*Math.PI/180)).toFixed(1)}"
        stroke="rgba(${acc},1)" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="18" cy="18" r="2" fill="rgba(${acc},0.8)"/>
    </svg>`;
  }

  // ── Node DOM creation ─────────────────────────────────────────
  function createNodeEl(node){
    const def = MODULE_DEFS[node.type];
    const color = def.color;
    const acc = hexToRgbSc(color);
    const el = document.createElement('div');
    el.className = 'sc-node';
    el.id = 'scnode-'+node.id;
    el.style.left = node.x+'px';
    el.style.top  = node.y+'px';
    el.style.borderColor = `rgba(${acc},0.35)`;

    // Header
    const hd = document.createElement('div');
    hd.className = 'sc-node-hd';
    const dot = document.createElement('div');
    dot.className='sc-node-dot';
    dot.style.background=color;
    dot.style.boxShadow=node.enabled?`0 0 5px ${color}`:'none';
    const name=document.createElement('div');
    name.className='sc-node-name';
    name.style.color=color;
    name.textContent=def.label;
    const power=document.createElement('button');
    power.className='sc-node-power';
    power.style.color=node.enabled?color:'var(--dim)';
    power.innerHTML='⏻';
    power.addEventListener('click',e=>{ e.stopPropagation(); node.enabled=!node.enabled; rebuildAudioChain(); refreshNodeEl(node); drawCables(); updatePortConnectedStates(); updateScMiniPreview(); });
    const rm=document.createElement('button');
    rm.className='sc-node-remove'; rm.innerHTML='✕';
    rm.addEventListener('click',e=>{ e.stopPropagation();
      scEdges=scEdges.filter(e=>e.fromId!==node.id&&e.toId!==node.id);
      scNodes=scNodes.filter(n=>n.id!==node.id);
      el.remove(); rebuildAudioChain(); drawCables(); updatePortConnectedStates(); updateScMiniPreview();
    });
    hd.append(dot,name,power,rm);
    el.appendChild(hd);

    // Body
    const body=document.createElement('div');
    body.className='sc-node-body';

    if(def.select){
      const sel=document.createElement('select');
      sel.className='sc-select';
      sel.style.borderColor=`rgba(${acc},0.3)`;
      sel.style.color=color;
      def.select.options.forEach(opt=>{
        const o=document.createElement('option');
        o.value=opt; o.textContent=def.select.fmt(opt);
        if(opt===(node.selectVal||def.select.def)) o.selected=true;
        sel.appendChild(o);
      });
      sel.addEventListener('change',e=>{ node.selectVal=e.target.value; updateNodeParams(node); });
      body.appendChild(sel);
    }

    const knobRow=document.createElement('div');
    knobRow.className='sc-knob-row';
    def.knobs.forEach(kd=>{
      const val=node.params[kd.id]??kd.def;
      const wrap=document.createElement('div'); wrap.className='sc-knob-wrap';
      const knobEl=document.createElement('div'); knobEl.className='sc-knob';
      knobEl.innerHTML=renderScKnob(kd,val,color);
      const lbl=document.createElement('div'); lbl.className='sc-knob-label'; lbl.textContent=kd.label;
      const valEl=document.createElement('div'); valEl.className='sc-knob-val'; valEl.style.color=color; valEl.textContent=kd.fmt(val);
      let dy0=0,v0=0;
      knobEl.addEventListener('mousedown',e=>{
        dy0=e.clientY; v0=node.params[kd.id]??kd.def; e.preventDefault(); e.stopPropagation();
        function onM(ev){
          const dy=dy0-ev.clientY; const range=kd.max-kd.min;
          let nv;
          if(kd.log){const lr=Math.log(kd.max)-Math.log(Math.max(kd.min,1e-6));nv=Math.exp(Math.max(Math.log(Math.max(kd.min,1e-6)),Math.min(Math.log(kd.max),Math.log(Math.max(v0,1e-6))+(dy/120)*lr)));}
          else nv=Math.max(kd.min,Math.min(kd.max,v0+(dy/120)*range));
          node.params[kd.id]=nv;
          knobEl.innerHTML=renderScKnob(kd,nv,color);
          valEl.textContent=kd.fmt(nv);
          updateNodeParams(node);
        }
        function onU(){ window.removeEventListener('mousemove',onM); window.removeEventListener('mouseup',onU); }
        window.addEventListener('mousemove',onM); window.addEventListener('mouseup',onU);
      });
      knobEl.addEventListener('dblclick',()=>{ node.params[kd.id]=kd.def; knobEl.innerHTML=renderScKnob(kd,kd.def,color); valEl.textContent=kd.fmt(kd.def); updateNodeParams(node); });
      // Square MOD port below each knob
      const sqPortWrap=document.createElement('div'); sqPortWrap.style.cssText='display:flex;flex-direction:column;align-items:center;gap:1px;';
      const sqP=document.createElement('div'); sqP.className='sc-knob-sqport';
      sqP.style.borderColor=color; sqP.style.color=color;
      sqP.dataset.node=node.id; sqP.dataset.knob=kd.id; sqP.dataset.sqmod='1';
      sqP.addEventListener('mouseenter',()=>{
        const isConn=ctrlEdges.some(e=>e.toNodeId===node.id&&e.toKnobId===kd.id);
        if(isConn){ sqP.style.background='#f54242'; sqP.style.borderColor='#f54242'; sqP.title='Click to disconnect'; }
      });
      sqP.addEventListener('mouseleave',()=>{ sqP.style.background=''; sqP.style.borderColor=color; sqP.title=''; });
      sqP.addEventListener('click',e=>{ e.stopPropagation(); handleKnobPortClick(node.id,kd.id,sqP,color); });
      const sqLbl=document.createElement('div'); sqLbl.className='sc-knob-sqport-label'; sqLbl.textContent='MOD';
      sqPortWrap.append(sqP,sqLbl);
      wrap.append(knobEl,lbl,valEl,sqPortWrap); knobRow.appendChild(wrap);
    });
    body.appendChild(knobRow);

    // Ports row
    const portsRow=document.createElement('div');
    portsRow.className='sc-ports';

    // Input port (left)
    const inWrap=document.createElement('div'); inWrap.className='sc-port-in';
    const inPort=document.createElement('div'); inPort.className='sc-port';
    inPort.style.borderColor=color; inPort.style.color=color;
    inPort.dataset.node=node.id; inPort.dataset.port='IN';
    inPort.addEventListener('mouseenter',()=>{ updatePortHoverState(node.id,'IN',false,inPort); });
    inPort.addEventListener('mouseleave',()=>{ clearPortHover(inPort); });
    inPort.addEventListener('click',e=>{ e.stopPropagation(); handlePortClick(node.id,'IN',false,inPort); });
    const inLbl=document.createElement('div'); inLbl.className='sc-port-label'; inLbl.textContent='IN';
    inWrap.append(inPort,inLbl);
    portsRow.appendChild(inWrap);

    // Output port(s) (right)
    const outPorts = def.ports?.out || ['OUT'];
    const outWrap=document.createElement('div'); outWrap.className='sc-port-out'; outWrap.style.flexDirection='column'; outWrap.style.gap='4px';
    outPorts.forEach(portName=>{
      const pw=document.createElement('div'); pw.style.display='flex'; pw.style.flexDirection='column'; pw.style.alignItems='flex-end'; pw.style.gap='2px';
      const op=document.createElement('div'); op.className='sc-port';
      op.style.borderColor=color; op.style.color=color;
      op.dataset.node=node.id; op.dataset.port=portName;
      op.addEventListener('mouseenter',()=>{ updatePortHoverState(node.id,portName,true,op); });
      op.addEventListener('mouseleave',()=>{ clearPortHover(op); });
      op.addEventListener('click',e=>{ e.stopPropagation(); handlePortClick(node.id,portName,true,op); });
      const ol=document.createElement('div'); ol.className='sc-port-label'; ol.textContent=portName;
      pw.append(ol,op); outWrap.appendChild(pw);
    });
    portsRow.appendChild(outWrap);
    body.appendChild(portsRow);
    el.appendChild(body);

    // Drag to move
    let dragging=false, dx=0, dy=0;
    hd.addEventListener('mousedown',e=>{
      if(e.target!==hd&&e.target!==dot&&e.target!==name) return;
      dragging=true; dx=e.clientX-node.x; dy=e.clientY-node.y; e.preventDefault();
      function onM(ev){ if(!dragging)return; node.x=ev.clientX-dx; node.y=ev.clientY-dy; el.style.left=node.x+'px'; el.style.top=node.y+'px'; drawCables(); updatePortConnectedStates(); }
      function onU(){ dragging=false; window.removeEventListener('mousemove',onM); window.removeEventListener('mouseup',onU); }
      window.addEventListener('mousemove',onM); window.addEventListener('mouseup',onU);
    });

    el.style.opacity = node.enabled ? '1' : '0.45';
    return el;
  }

  function refreshNodeEl(node){
    const el=document.getElementById('scnode-'+node.id);
