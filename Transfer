  // ── COMMAND Modules ──────────────────────────────────────────

  const CMD_DEFS = {
    lfo:  { label:'LFO',  color:'#00ff50', desc:'Low Freq Oscillator',
            modes:['SINE','SQUARE','SAW','TRI','RAMP'],
            params:{ shape:'SINE', rate:1, depth:1, min:0, max:1 } },
    env:  { label:'ENV',  color:'#00e870', desc:'Envelope',
            modes:['ATK','DCY','SUS','REL'],
            params:{ attack:0.01, decay:0.3, sustain:0.7, release:0.5, threshold:-40 } },
    seq:  { label:'SEQ',  color:'#00d060', desc:'Step Sequencer',
            modes:['PLAY','PAUSE','RESET','EDIT'],
            params:{ bpm:120, steps:8, gate:0.5,
                     values:[0,0.25,0.5,0.75,1,0.75,0.5,0.25] } },
    rand: { label:'RAND', color:'#00b850', desc:'Random',
            modes:['S+H','GLIDE','BURST'],
            params:{ rate:2, min:0, max:1, smooth:0 } },
    math: { label:'MATH', color:'#00a040', desc:'Expression',
            modes:['EXPR','MAP','SCALE','CLAMP'],
            params:{ expr:'sin(t*2)*0.5+0.5', inMin:0, inMax:1, outMin:0, outMax:1 } },
    ifnode: { label:'IF', color:'#009030', desc:'Conditional',
            modes:['GT','LT','EQ','NEQ','BETWEEN'],
            params:{ condition:'a > 0.5', trueVal:1, falseVal:0 } },
    logic: { label:'GATE', color:'#008028', desc:'Logic Gate',
            modes:['AND','OR','NOT','XOR','NAND','NOR'],
            params:{ mode:'AND', threshold:0.5 } },
  };

  // Runtime state for command nodes
  let cmdNodes = []; // [{id, type, x, y, enabled, params, mode, expr, audioNode:{output}}]
  let cmdEdges = []; // [{fromId, fromPort, toId, toPort}] — ctrl cables
  // Cross edges: cmd→signal (ctrl port on knob)
  let ctrlEdges = []; // [{fromId, toNodeId, toKnobId}]

  let cmdPendingPort = null;

  function hexToRgbCmd(hex){
    return `${parseInt(hex.slice(1,3),16)},${parseInt(hex.slice(3,5),16)},${parseInt(hex.slice(5,7),16)}`;
  }

  // ── Command node runtime (runs every animation frame) ─────────
  let cmdClock = 0; // seconds, updated in loop
  let cmdLastTime = null;

  function tickCmdNodes(ts){
    const now = ts / 1000;
    const dt = cmdLastTime ? Math.min(0.1, now - cmdLastTime) : 0;
    cmdLastTime = now;
    cmdClock += dt;

    cmdNodes.forEach(cn=>{
      if(!cn.enabled) return;
      let val = 0;
      const p = cn.params;
      const t = cmdClock;

      if(cn.type==='lfo'){
        const phase = t * (p.rate||1) * Math.PI * 2;
        const shape = cn.mode||'SINE';
        let raw;
        if(shape==='SINE')   raw = Math.sin(phase);
        else if(shape==='SQUARE') raw = Math.sign(Math.sin(phase));
        else if(shape==='SAW')    raw = ((phase/(Math.PI*2))%1)*2-1;
        else if(shape==='TRI')    raw = Math.asin(Math.sin(phase))*2/Math.PI;
        else if(shape==='RAMP')   raw = 1-((phase/(Math.PI*2))%1)*2;
        else raw = Math.sin(phase);
        val = ((raw+1)/2) * (p.depth||1);
        val = (p.min||0) + val * ((p.max||1)-(p.min||0));
      }
      else if(cn.type==='rand'){
        if(!cn._lastRand || t - cn._lastRand > 1/(p.rate||2)){
          cn._randVal = (p.min||0) + Math.random()*((p.max||1)-(p.min||0));
          cn._lastRand = t;
        }
        val = cn._randVal||0;
      }
      else if(cn.type==='math'){
        try{
          const expr = cn.expr || p.expr || 'sin(t*2)*0.5+0.5';
          const a = cn._inputA||0, b = cn._inputB||0;
          // Safe eval with math functions
          val = Function('t','a','b','sin','cos','tan','abs','floor','ceil','round','min','max','pow','sqrt','PI',
            `return ${expr}`
          )(t,a,b,Math.sin,Math.cos,Math.tan,Math.abs,Math.floor,Math.ceil,Math.round,Math.min,Math.max,Math.pow,Math.sqrt,Math.PI);
          val = isFinite(val) ? Math.max(-1,Math.min(2,val)) : 0;
        }catch(e){ val = 0; }
      }
      else if(cn.type==='seq'){
        const bpm = p.bpm||120;
        const steps = Math.round(p.steps||8);
        const stepDur = 60/bpm;
        const stepIdx = Math.floor((t/stepDur) % steps);
        val = (p.values||[])[stepIdx] ?? 0;
        cn._step = stepIdx;
      }
      else if(cn.type==='logic'){
        const a = cn._inputA||0, b = cn._inputB||0;
        const thr = p.threshold||0.5;
        const ai = a>thr, bi = b>thr;
        const mode = cn.mode||'AND';
        if(mode==='AND')  val = (ai&&bi)?1:0;
        else if(mode==='OR')  val = (ai||bi)?1:0;
        else if(mode==='NOT') val = ai?0:1;
        else if(mode==='XOR') val = (ai!==bi)?1:0;
        else if(mode==='NAND') val = !(ai&&bi)?1:0;
        else if(mode==='NOR')  val = !(ai||bi)?1:0;
      }
      else if(cn.type==='ifnode'){
        const a = cn._inputA||0;
        const mode = cn.mode||'GT';
        const thr = p.threshold||0.5;
        let test = false;
        if(mode==='GT') test = a > thr;
        else if(mode==='LT') test = a < thr;
        else if(mode==='EQ') test = Math.abs(a-thr)<0.05;
        else if(mode==='NEQ') test = Math.abs(a-thr)>=0.05;
        val = test ? (p.trueVal??1) : (p.falseVal??0);
      }
      else if(cn.type==='env'){
        // Auto-cycling envelope
        const total = (p.attack||0.01)+(p.decay||0.3)+(p.sustain||0.7)+(p.release||0.5);
        const phase = t % total;
        const atk = p.attack||0.01, dcy = p.decay||0.3, sus = p.sustain||0.7, rel = p.release||0.5;
        if(phase < atk) val = phase/atk;
        else if(phase < atk+dcy) val = 1-(phase-atk)/dcy*(1-sus);
        else if(phase < atk+dcy+rel) val = sus;
        else val = sus*(1-(phase-atk-dcy-rel)/rel);
        val = Math.max(0,Math.min(1,val));
      }

      cn._output = val;

      // Apply to connected knobs
      ctrlEdges.filter(e=>e.fromId===cn.id).forEach(e=>{
        const targetNode = scNodes.find(n=>n.id===e.toNodeId);
        if(!targetNode) return;
        const kd = MODULE_DEFS[targetNode.type]?.knobs?.find(k=>k.id===e.toKnobId);
        if(!kd) return;
        // Add to base param value, clamped
        const base = targetNode.params[e.toKnobId] ?? kd.def;
        const modulated = Math.max(kd.min, Math.min(kd.max, base + val * (kd.max - kd.min) * 0.5));
        // Apply without saving to params
        if(targetNode.audioNode) updateNodeParamDirect(targetNode, e.toKnobId, modulated);
      });

      // Update CRT display
      const crtEl = document.getElementById('cmd-crt-'+cn.id);
      if(crtEl){
        const valEl = crtEl.querySelector('.sc-cmd-crt-val');
        if(valEl) valEl.textContent = formatCmdVal(cn, val);
      }
    });
  }

  function formatCmdVal(cn, val){
    if(cn.type==='lfo') return `${cn.mode||'SINE'} ${val.toFixed(3)}`;
    if(cn.type==='seq') return `STEP ${(cn._step||0)+1} · ${val.toFixed(2)}`;
    if(cn.type==='math') return `= ${val.toFixed(4)}`;
    if(cn.type==='logic') return `${cn.mode||'AND'} → ${val>0.5?'TRUE':'FALSE'}`;
    if(cn.type==='ifnode') return `${cn.mode||'GT'} → ${val.toFixed(2)}`;
    if(cn.type==='env') return `ENV ${val.toFixed(3)}`;
    if(cn.type==='rand') return `RND ${val.toFixed(3)}`;
    return val.toFixed(3);
  }

  function updateNodeParamDirect(node,knobId,val){
    if(!node.audioNode||!audioCtx)return;
    const n=node.audioNode,ct=audioCtx.currentTime,tc=0.008;
    try{switch(knobId){
      case 'gain':if(n.nodes?.[0]?.gain)n.nodes[0].gain.setTargetAtTime(val,ct,tc);break;
      case 'gainA':if(n.gainA)n.gainA.gain.setTargetAtTime(val,ct,tc);break;
      case 'gainB':if(n.gainB)n.gainB.gain.setTargetAtTime(val,ct,tc);break;
      case 'pan':if(n.nodes?.[0]?.pan)n.nodes[0].pan.setTargetAtTime(val,ct,tc);else if(n.pan?.pan)n.pan.pan.setTargetAtTime(val,ct,tc);break;
      case 'freq':if(n.f?.frequency)n.f.frequency.setTargetAtTime(val,ct,tc);else if(n.nodes?.[0]?.frequency)n.nodes[0].frequency.setTargetAtTime(val,ct,tc);break;
      case 'q':if(n.nodes?.[0]?.Q)n.nodes[0].Q.setTargetAtTime(val,ct,tc);break;
      case 'wet':if(n.wet?.gain){n.wet.gain.setTargetAtTime(val,ct,tc);if(n.dry?.gain)n.dry.gain.setTargetAtTime(1-val,ct,tc);}break;
      case 'drive':if(n.ws){const k=val*200+1,c=new Float32Array(256);for(let i=0;i<256;i++){const x=i*2/256-1;c[i]=(Math.PI+k)*x/(Math.PI+k*Math.abs(x));}n.ws.curve=c;}break;
      case 'tone':if(n.tone?.frequency)n.tone.frequency.setTargetAtTime(val,ct,tc);break;
      case 'time':if(n.dly?.delayTime)n.dly.delayTime.setTargetAtTime(val,ct,tc);else if(n.dlyL?.delayTime){n.dlyL.delayTime.setTargetAtTime(val,ct,tc);n.dlyR.delayTime.setTargetAtTime(val*1.5,ct,tc);}break;
      case 'feedback':if(n.fb?.gain)n.fb.gain.setTargetAtTime(val,ct,tc);break;
      case 'rate':if(n.lfo?.frequency)n.lfo.frequency.setTargetAtTime(val,ct,tc);break;
      case 'depth':if(n.lfoGain?.gain)n.lfoGain.gain.setTargetAtTime(val,ct,tc);break;
      case 'threshold':if(n.nodes?.[0]?.threshold)n.nodes[0].threshold.setTargetAtTime(val,ct,tc);break;
      case 'ratio':if(n.nodes?.[0]?.ratio)n.nodes[0].ratio.setTargetAtTime(val,ct,tc);break;
      case 'attack':if(n.nodes?.[0]?.attack)n.nodes[0].attack.setTargetAtTime(val,ct,tc);break;
      case 'release':if(n.nodes?.[0]?.release)n.nodes[0].release.setTargetAtTime(val,ct,tc);break;
      case 'width':if(n.gL?.gain){n.gL.gain.setTargetAtTime(val,ct,tc);n.gR.gain.setTargetAtTime(val,ct,tc);}break;
      case 'level':if(n.lvl?.gain)n.lvl.gain.setTargetAtTime(val,ct,tc);break;
      case 'fb':if(n.fb?.gain)n.fb.gain.setTargetAtTime(val,ct,tc);break;
      case 'low':if(n.nodes?.[0]?.gain)n.nodes[0].gain.setTargetAtTime(val,ct,tc);break;
      case 'mid':if(n.nodes?.[1]?.gain)n.nodes[1].gain.setTargetAtTime(val,ct,tc);break;
      case 'high':if(n.nodes?.[2]?.gain)n.nodes[2].gain.setTargetAtTime(val,ct,tc);break;
    }}catch(e){}
  }

  // ── Create command node element ───────────────────────────────
