  function initKnobs(){
    Object.keys(KNOB_DEFS).forEach(name=>{
      renderKnob(name);
      const el = document.getElementById('knob'+name.charAt(0).toUpperCase()+name.slice(1));
      if(!el) return;
      let dragStartY=0, dragStartVal=0;
      el.addEventListener('mousedown', e=>{
        dragStartY = e.clientY;
        dragStartVal = knobVals[name];
        e.preventDefault();
        const d = KNOB_DEFS[name];
        function onMove(ev){
          const dy = dragStartY - ev.clientY; // up = increase
          const range = d.max - d.min;
          let delta;
          if(d.log){
            const logRange = Math.log(d.max) - Math.log(d.min);
            const logStart = Math.log(dragStartVal);
            const newLog = logStart + (dy/150)*logRange;
            delta = Math.exp(Math.max(Math.log(d.min), Math.min(Math.log(d.max), newLog))) - dragStartVal;
          } else {
            delta = (dy/150)*range;
          }
          knobVals[name] = Math.max(d.min, Math.min(d.max, dragStartVal + delta));
          renderKnob(name);
          applyKnobVal(name);
        }
        function onUp(){ window.removeEventListener('mousemove',onMove); window.removeEventListener('mouseup',onUp); }
        window.addEventListener('mousemove',onMove);
        window.addEventListener('mouseup',onUp);
      });

      // Double-click to reset
      el.addEventListener('dblclick', ()=>{
        knobVals[name] = KNOB_DEFS[name].def;
        renderKnob(name);
        applyKnobVal(name);
      });
    });
  }

