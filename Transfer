    // Header
    const hd = document.createElement('div');
    hd.className = 'sc-cmd-node-hd';
    const dot = document.createElement('div');
    dot.className = 'sc-cmd-dot';
    dot.style.cssText = `width:6px;height:6px;background:${color};box-shadow:0 0 4px ${color};flex-shrink:0;`;
    const name = document.createElement('div');
    name.className = 'sc-cmd-name';
    name.style.color = color;
    name.textContent = def.label;
    const rm = document.createElement('button');
    rm.className = 'sc-cmd-node-remove'; rm.innerHTML='✕';
    rm.addEventListener('click', e=>{ e.stopPropagation();
      cmdNodes = cmdNodes.filter(n=>n.id!==cn.id);
      ctrlEdges = ctrlEdges.filter(e=>e.fromId!==cn.id);
      cmdEdges = cmdEdges.filter(e=>e.fromId!==cn.id&&e.toId!==cn.id);
      el.remove(); drawCables(); updatePortConnectedStates();
    });
    hd.append(dot,name,rm);
    el.appendChild(hd);

    // CRT display
    const crt = document.createElement('div');
    crt.className = 'sc-cmd-crt';
    crt.id = 'cmd-crt-'+cn.id;
    const crtVal = document.createElement('span');
    crtVal.className = 'sc-cmd-crt-val';
    crtVal.textContent = def.label+' READY';
    const cursor = document.createElement('span');
    cursor.className = 'sc-cmd-crt-cursor';
    cursor.textContent = '█';
    crt.append(crtVal, cursor);
    el.appendChild(crt);

    // Mode buttons
    const btns = document.createElement('div');
    btns.className = 'sc-cmd-btns';
    def.modes.forEach(mode=>{
      const b = document.createElement('button');
      b.className = 'sc-cmd-btn' + (cn.mode===mode?' active':'');
      b.textContent = mode;
      b.style.color = color;
      b.style.borderColor = cn.mode===mode ? color : 'var(--b2)';
      b.addEventListener('click', e=>{ e.stopPropagation();
        cn.mode = mode;
        btns.querySelectorAll('.sc-cmd-btn').forEach(x=>{ x.classList.remove('active'); x.style.borderColor='var(--b2)'; });
        b.classList.add('active'); b.style.borderColor = color;
      });
      btns.appendChild(b);
    });
    el.appendChild(btns);

    // Expression / value input
    const inp = document.createElement('input');
    inp.className = 'sc-cmd-input';
    inp.type = 'text';
    inp.placeholder = def.type==='math'?'sin(t*2)*0.5+0.5':'value...';
    inp.value = cn.expr || (cn.type==='math'?cn.params.expr:'') || '';
    inp.addEventListener('input', e=>{ e.stopPropagation(); cn.expr=e.target.value; if(cn.type==='math') cn.params.expr=e.target.value; });
    inp.addEventListener('mousedown', e=>e.stopPropagation());
    inp.addEventListener('keydown', e=>e.stopPropagation());
    el.appendChild(inp);

    const portsRow=document.createElement('div');portsRow.className='sc-cmd-ports';
    function mkSP(pName,isOut){
      const w=document.createElement('div');w.className=isOut?'sc-cmd-port-out':'sc-cmd-port-in';
      const p2=document.createElement('div');p2.className='sc-sqport';p2.style.borderColor=color;p2.style.color=color;
      p2.dataset.node=cn.id;p2.dataset.port=pName;p2.dataset.cmd='1';
      p2.addEventListener('mouseenter',()=>{if(isCmdPortConnected(cn.id,pName,isOut)){p2.style.background='#f54242';p2.style.borderColor='#f54242';}});
      p2.addEventListener('mouseleave',()=>{p2.style.background='';p2.style.borderColor=color;});
      p2.addEventListener('click',e=>{e.stopPropagation();handleCmdPortClick(cn.id,pName,isOut,p2);});
      const l2=document.createElement('div');l2.className='sc-sqport-label';l2.textContent=pName;
      if(isOut)w.append(l2,p2);else w.append(p2,l2);return w;
    }
    const pi=def.portsIn||0;
    if(pi===0){portsRow.appendChild(document.createElement('div'));portsRow.appendChild(mkSP('OUT',true));}
    else if(pi===1){portsRow.appendChild(mkSP('IN',false));portsRow.appendChild(mkSP('OUT',true));}
    else{const ig=document.createElement('div');ig.style.cssText='display:flex;flex-direction:column;gap:3px;';ig.appendChild(mkSP('IN A',false));ig.appendChild(mkSP('IN B',false));portsRow.appendChild(ig);portsRow.appendChild(mkSP('OUT',true));}
    el.appendChild(portsRow);

    // Drag
    let dragging=false,dx=0,dy=0;
    hd.addEventListener('mousedown',e=>{
      if(e.target!==hd&&e.target!==dot&&e.target!==name) return;
      dragging=true; dx=e.clientX-cn.x; dy=e.clientY-cn.y; e.preventDefault();
      function onM(ev){ if(!dragging)return; cn.x=ev.clientX-dx; cn.y=ev.clientY-dy; el.style.left=cn.x+'px'; el.style.top=cn.y+'px'; drawCables(); updatePortConnectedStates(); }
      function onU(){ dragging=false; window.removeEventListener('mousemove',onM); window.removeEventListener('mouseup',onU); }
      window.addEventListener('mousemove',onM); window.addEventListener('mouseup',onU);
    });

    return el;
  }

  function isCmdPortConnected(nodeId, portName, isOut){
    return cmdEdges.some(e=> isOut ? (e.fromId===nodeId&&e.fromPort===portName) : (e.toId===nodeId&&e.toPort===portName));
  }

  function handleCmdPortClick(nodeId, portName, isOut, portEl){
    if(!pendingPort){
      pendingPort = {nodeId, portName, isOut, el:portEl, isCmd:true};
      portEl.classList.add('active');
      if(scCanvas) scCanvas.classList.add('wiring');
      const body=document.getElementById('scBody');
      const bodyRect=body.getBoundingClientRect();
      function onMove(e){ scDragCablePos={x:e.clientX-bodyRect.left,y:e.clientY-bodyRect.top}; drawCables(); updatePortConnectedStates(); }
      function onUp(){ window.removeEventListener('mousemove',onMove); window.removeEventListener('mouseup',onUp); }
      window.addEventListener('mousemove',onMove); window.addEventListener('mouseup',onUp);
    } else {
      const a = pendingPort;
      if(a.nodeId===nodeId&&a.portName===portName){ cancelPendingCable(); return; }
      if(a.isOut===isOut){ cancelPendingCable(); handleCmdPortClick(nodeId,portName,isOut,portEl); return; }
      // If pending is a knob MOD port, create ctrl edge
      if(a.isKnob && isOut){
        cancelPendingCable();
        const idx=ctrlEdges.findIndex(e=>e.toNodeId===a.nodeId&&e.toKnobId===a.knobId);
        if(idx>=0) ctrlEdges.splice(idx,1);
        ctrlEdges.push({fromId:nodeId, toNodeId:a.nodeId, toKnobId:a.knobId});
        drawCables(); updatePortConnectedStates(); return;
      }
      cancelPendingCable();
      const fromId = a.isOut ? a.nodeId : nodeId;
      const fromPort = a.isOut ? a.portName : portName;
      const toId = a.isOut ? nodeId : a.nodeId;
      const toPort = a.isOut ? portName : a.portName;
      cmdEdges.push({fromId,fromPort,toId,toPort});
      drawCables(); updatePortConnectedStates();
    }
  }

  function addCmdModule(type){
    const def = CMD_DEFS[type];
    const body = document.getElementById('scBody');
    const W=body.offsetWidth, H=body.offsetHeight;
    const cn = {
      id: 'cmd_'+Date.now(),
      type, enabled:true,
      mode: def.modes[0],
      params: {...def.params},
      expr: def.params.expr||'',
      x: Math.max(100,Math.random()*(W-200)),
      y: Math.max(40, Math.random()*(H-180)),
      _output: 0,
    };
    cmdNodes.push(cn);
    body.appendChild(createCmdNodeEl(cn));
    drawCables(); updatePortConnectedStates();
    buildCmdPicker();
  }

  function buildCmdPicker(){
    const body = document.getElementById('scCmdPickerBody');
    if(!body) return;
    body.innerHTML='';
    Object.entries(CMD_DEFS).forEach(([type,def])=>{
      const btn = document.createElement('button');
      btn.className = 'sc-cmd-pick-btn';
      btn.innerHTML = `<span style="color:${def.color}">${def.label}</span> <span style="color:var(--dim);font-size:7px;">${def.desc}</span>`;
      btn.addEventListener('click', ()=>addCmdModule(type));
      body.appendChild(btn);
    });
  }

  // ── Square port picker collapse/drag ──────────────────────────
  (function(){
    let pdx=0,pdy=0,pdragging=false,pmoved=false;
    const hd = document.getElementById('scCmdPickerHd');
    if(!hd) return;

    // Animated square — color cycles
    const sqRect  = document.getElementById('scSqRect');
    const sqGlyph = document.getElementById('scSqGlyph');
    const CMD_COLORS = ['#00ff50','#00e870','#00d060','#00b850','#00a040','#009030','#00ff80'];
    function sqLerp(a,b,t){
      const p=s=>parseInt(s.slice(1,3),16),q=s=>parseInt(s.slice(3,5),16),r=s=>parseInt(s.slice(5,7),16);
      return `rgb(${Math.round(p(a)+(p(b)-p(a))*t)},${Math.round(q(a)+(q(b)-q(a))*t)},${Math.round(r(a)+(r(b)-r(a))*t)})`;
    }
    let sqAnimId=null;
    function startSqAnim(){
      if(sqAnimId) return;
      let t=0;
      function frame(){
        t+=0.006;
        const n=CMD_COLORS.length;
        const idx=Math.floor(t%n);
        const col=sqLerp(CMD_COLORS[idx%n],CMD_COLORS[(idx+1)%n],t%1);
        if(sqRect)  sqRect.setAttribute('stroke',col);
        if(sqGlyph) sqGlyph.setAttribute('fill',col);
        sqAnimId=requestAnimationFrame(frame);
      }
      sqAnimId=requestAnimationFrame(frame);
    }
    startSqAnim();

    let collapsed=false;
    const sqEl = document.getElementById('scCmdPickerSq');
    function toggleCollapse(){
      if(pmoved) return;
      const picker = document.getElementById('scCmdPicker');
      collapsed=!collapsed;
      picker.classList.toggle('collapsed',collapsed);
    }
    sqEl && sqEl.addEventListener('click',e=>{ e.stopPropagation(); if(!pmoved) toggleCollapse(); });

    hd.addEventListener('mousedown',e=>{
      pdragging=true; pmoved=false;
      const picker = document.getElementById('scCmdPicker');
      const r = picker.getBoundingClientRect();
      pdx=e.clientX-r.left; pdy=e.clientY-r.top;
      e.preventDefault();
    });
    window.addEventListener('mousemove',e=>{
      if(!pdragging) return;
      pmoved=true;
      const picker = document.getElementById('scCmdPicker');
      const body = document.getElementById('scBody');
      const br = body.getBoundingClientRect();
      const pr = picker.getBoundingClientRect();
      let nx=Math.max(0,Math.min(br.width-pr.width,e.clientX-br.left-pdx));
      let ny=Math.max(0,Math.min(br.height-pr.height,e.clientY-br.top-pdy));
      picker.style.right='auto'; picker.style.left=nx+'px';
      picker.style.bottom='auto'; picker.style.top=ny+'px';
    });
    window.addEventListener('mouseup',()=>{ pdragging=false; });
  })();

