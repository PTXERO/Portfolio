  // ── Port hover — show ✕ if connected ────────────────────────
  function isPortConnected(nodeId, portName, isOut){
    return scEdges.some(e=>
      isOut ? (e.fromId===nodeId && e.fromPort===portName)
            : (e.toId===nodeId   && e.toPort===portName)
    );
  }

  function updatePortHoverState(nodeId, portName, isOut, portEl){
    if(pendingPort) return; // don't change state while wiring
    if(isPortConnected(nodeId, portName, isOut)){
      portEl.style.background = '#f54242';
      portEl.style.borderColor = '#f54242';
      portEl.title = 'Click to disconnect';
    }
  }

  function clearPortHover(portEl){
    portEl.style.background = '';
    portEl.title = '';
    // Restore border color from dataset
    portEl.style.borderColor = portEl.dataset.color || '';
  }

  // ── Port click — cable connection ────────────────────────────
  function cancelPendingCable(){
    if(!pendingPort) return;
    pendingPort.el.classList.remove('active');
    pendingPort=null; scDragCablePos=null;
    if(scCanvas) scCanvas.classList.remove('wiring');
    drawCables(); updatePortConnectedStates();
  }

  function handlePortClick(nodeId, portName, isOut, portEl){
    if(!pendingPort){
      // If port already connected — clicking it removes the cable
      if(isPortConnected(nodeId, portName, isOut)){
        if(isOut){
          scEdges=scEdges.filter(e=>!(e.fromId===nodeId&&e.fromPort===portName));
        } else {
          scEdges=scEdges.filter(e=>!(e.toId===nodeId&&e.toPort===portName));
        }
        clearPortHover(portEl);
        rebuildAudioChain(); drawCables(); updatePortConnectedStates(); updateScMiniPreview();
        return;
      }
      // Start cable — highlight port, show dashed preview following cursor
      pendingPort={nodeId,portName,isOut,el:portEl, isCmd:true};
      portEl.classList.add('active');
      if(scCanvas) scCanvas.classList.add('wiring');
      const body=document.getElementById('scBody');
      const bodyRect=body.getBoundingClientRect();
      function onMove(e){
        scDragCablePos={x:e.clientX-bodyRect.left,y:e.clientY-bodyRect.top};
        drawCables(); updatePortConnectedStates();
      }
      function onUp(){ window.removeEventListener('mousemove',onMove); window.removeEventListener('mouseup',onUp); }
      window.addEventListener('mousemove',onMove);
      window.addEventListener('mouseup',onUp);
    } else {
      const a=pendingPort;
      // Clicking the same port cancels
      if(a.nodeId===nodeId && a.portName===portName){ cancelPendingCable(); return; }
      // Clicking same direction — cancel and restart from new port
      if(a.isOut===isOut){ cancelPendingCable(); handlePortClick(nodeId,portName,isOut,portEl); return; }

      cancelPendingCable();

      const fromId   = a.isOut ? a.nodeId   : nodeId;
      const fromPort = a.isOut ? a.portName : portName;
      const toId     = a.isOut ? nodeId     : a.nodeId;
      const toPort   = a.isOut ? portName   : a.portName;

      // OUTPUT node accepts infinite inputs; all other inputs are exclusive
      if(toId !== SC_OUTPUT_ID){
        scEdges=scEdges.filter(e=>!(e.toId===toId&&e.toPort===toPort));
      }
      scEdges.push({fromId,fromPort,toId,toPort});
      rebuildAudioChain(); drawCables(); updatePortConnectedStates(); updateScMiniPreview();
    }
  }

  function scCanvasClick(e){
    if(pendingPort){ cancelPendingCable(); }
  }

  // ── Knob MOD port click ──────────────────────────────────────
  function handleKnobPortClick(nodeId, knobId, portEl, color){
    if(!pendingPort){
      // Disconnect if already connected
      const existing=ctrlEdges.findIndex(e=>e.toNodeId===nodeId&&e.toKnobId===knobId);
      if(existing>=0){
        ctrlEdges.splice(existing,1);
        portEl.style.background=''; portEl.style.borderColor=color;
        drawCables(); updatePortConnectedStates(); return;
      }
      // Start pending from knob as destination
      pendingPort={nodeId,portName:knobId,isOut:false,el:portEl,isKnob:true,knobId};
      portEl.classList.add('active');
      if(scCanvas) scCanvas.classList.add('wiring');
      const body=document.getElementById('scBody');
      const bodyRect=body.getBoundingClientRect();
      function onMove(e){ scDragCablePos={x:e.clientX-bodyRect.left,y:e.clientY-bodyRect.top}; drawCables(); updatePortConnectedStates(); }
      function onUp(){ window.removeEventListener('mousemove',onMove); window.removeEventListener('mouseup',onUp); }
      window.addEventListener('mousemove',onMove); window.addEventListener('mouseup',onUp);
    } else {
      const a=pendingPort;
      if(a.isKnob){ cancelPendingCable(); return; } // knob→knob not allowed
      if(!a.isCmd){ cancelPendingCable(); return; }  // must come from cmd node
      cancelPendingCable();
      const idx=ctrlEdges.findIndex(e=>e.toNodeId===nodeId&&e.toKnobId===knobId);
      if(idx>=0) ctrlEdges.splice(idx,1);
      ctrlEdges.push({fromId:a.nodeId, toNodeId:nodeId, toKnobId:knobId});
      drawCables(); updatePortConnectedStates();
    }
  }

  // ── Add module ───────────────────────────────────────────────
  function addScModule(type){
    if(!audioCtx) initAudio();
    const def=MODULE_DEFS[type];
    const params={};
    def.knobs.forEach(k=>{ params[k.id]=k.def; });
    const body=document.getElementById('scBody');
    const W=body.offsetWidth, H=body.offsetHeight;
    const node={
      id: Date.now()+'',
      type, enabled:true, params,
      selectVal:def.select?.def||null,
      audioNode:makeWebAudioNode(type,params,def.select?.def),
      x:Math.max(100,Math.random()*(W-200)),
      y:Math.max(40, Math.random()*(H-180)),
    };
    scNodes.push(node);
    const el=createNodeEl(node);
    body.appendChild(el);
    drawCables(); updatePortConnectedStates(); updateScMiniPreview();
    buildScPicker(); // refresh picker (stays visible)
  }

