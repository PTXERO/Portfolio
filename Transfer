<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RF</title>
<script src="../design-tokens.js"></script>
<script src="../site.config.js"></script>
<script src="rf.config.js"></script>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Bebas+Neue&family=DM+Mono:wght@300;400;500&display=swap">
<link rel="stylesheet" href="../shared.css">
<style>
:root{
  --bg:#07070a;--surface:#0d0d12;--panel:#101015;
  --border:#1c1c24;--b2:#28282f;
  --acc:#c8f542;--acc2:#42d4f5;--acc3:#f542a8;--acc4:#f5a542;
  --txt:#d8d8e0;--dim:#5a5a70;--mut:#2e2e38;
  --fmono:'Share Tech Mono',monospace;
  --fdisp:'Bebas Neue',sans-serif;
  --fbody:'DM Mono',monospace;
  --rf-acc:#42d4f5;--rf-accB:#f542a8;--rf-accC:#f5a542;
  --rf-grid:rgba(66,212,245,0.06);--rf-glow:rgba(66,212,245,0.18);
}
html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--txt);font-family:var(--fmono);font-size:12px;}

/* ── Header ── */
.rf-header{height:44px;display:flex;align-items:center;padding:0 16px;gap:10px;background:var(--surface);border-bottom:1px solid var(--border);position:relative;z-index:50;flex-shrink:0;}
.rf-home{padding:4px 11px;border:1px solid var(--b2);border-radius:2px;background:transparent;color:var(--dim);font-family:var(--fmono);font-size:10px;cursor:pointer;transition:all .15s;letter-spacing:.07em;text-decoration:none;flex-shrink:0;}
.rf-home:link,.rf-home:visited{color:var(--dim);}
.rf-home:hover{border-color:var(--rf-acc);color:var(--rf-acc);}
.rf-sep{width:1px;height:18px;background:var(--border);flex-shrink:0;}
.rf-title{font-family:var(--fdisp);font-size:24px;letter-spacing:.12em;color:var(--rf-acc);line-height:1;flex-shrink:0;}
.rf-ver{font-family:var(--fmono);font-size:9px;color:var(--dim);border:1px solid var(--b2);border-radius:2px;padding:2px 7px;letter-spacing:.1em;flex-shrink:0;}
.rf-status{font-size:9px;color:var(--dim);letter-spacing:.1em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;min-width:0;}
.rf-tuner-display{font-family:var(--fdisp);font-size:18px;color:var(--rf-acc);letter-spacing:.1em;flex-shrink:0;line-height:1;text-shadow:0 0 12px rgba(66,212,245,.4);}
.rf-tuner-unit{font-family:var(--fmono);font-size:9px;color:var(--dim);letter-spacing:.1em;margin-left:2px;flex-shrink:0;}
.rf-freq-display{font-family:var(--fmono);font-size:11px;color:var(--rf-acc);letter-spacing:.08em;flex-shrink:0;opacity:.8;}

/* ── Location inputs in header ── */
.rf-loc{display:flex;align-items:center;gap:5px;flex-shrink:0;}
.rf-loc-input{
  width:72px;background:var(--panel);border:1px solid var(--b2);
  color:var(--txt);font-family:var(--fmono);font-size:9px;
  letter-spacing:.05em;padding:3px 6px;border-radius:2px;outline:none;
  transition:border-color .15s;
}
.rf-loc-input:focus{border-color:var(--rf-acc);}
.rf-loc-btn{
  padding:3px 8px;border:1px solid var(--b2);border-radius:2px;
  background:transparent;color:var(--dim);font-family:var(--fmono);
  font-size:9px;letter-spacing:.08em;cursor:pointer;transition:all .15s;
  white-space:nowrap;flex-shrink:0;
}
.rf-loc-btn:hover{border-color:var(--rf-acc);color:var(--rf-acc);}
.rf-loc-btn.loading{border-color:var(--rf-accC);color:var(--rf-accC);pointer-events:none;}
.rf-loc-name{font-size:8px;color:var(--dim);letter-spacing:.08em;max-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex-shrink:0;}


/* ── Resume banner ── */
#rfResumeBanner{
  position:fixed;top:44px;left:50%;transform:translateX(-50%);
  z-index:400;background:var(--surface);border:1px solid var(--rf-accC);
  border-top:none;border-radius:0 0 3px 3px;
  display:flex;align-items:center;gap:10px;
  padding:6px 16px;cursor:pointer;
  font-family:var(--fmono);font-size:9px;letter-spacing:.12em;
  color:var(--rf-accC);transition:all .15s;
  box-shadow:0 4px 16px rgba(245,165,66,.12);
  animation:bannerDrop .25s ease;
}
@keyframes bannerDrop{from{opacity:0;transform:translateX(-50%) translateY(-8px);}to{opacity:1;transform:translateX(-50%) translateY(0);}}
#rfResumeBanner:hover{background:rgba(245,165,66,.08);border-color:var(--rf-accC);}
#rfResumeBanner.hidden{display:none;}
.resume-play{font-size:11px;}

#rfProg{position:fixed;top:44px;left:0;height:2px;background:var(--rf-acc);width:0;z-index:300;transition:width .3s;}

/* ── Workspace ── */
.rf-workspace{display:flex;height:calc(100vh - 44px);overflow:hidden;}
.rf-col{display:flex;flex-direction:column;width:220px;flex-shrink:0;border-right:1px solid var(--border);background:var(--bg);}
.rf-col--right{border-right:none;border-left:1px solid var(--border);}

/* ── Tiles ── */
.rf-tile{flex:1;position:relative;border-bottom:1px solid var(--border);cursor:pointer;overflow:hidden;transition:background .15s;display:flex;flex-direction:column;}
.rf-tile:last-child{border-bottom:none;}
.rf-tile:hover{background:rgba(66,212,245,.03);}
.rf-tile:hover .tile-label{color:var(--rf-acc);}
.rf-tile:hover .tile-corner{opacity:1;}
.tile-label{font-family:var(--fmono);font-size:9px;letter-spacing:.25em;text-transform:uppercase;color:var(--dim);padding:10px 12px 6px;transition:color .15s;flex-shrink:0;display:flex;align-items:center;gap:6px;}
.tile-label::before{content:'';width:4px;height:4px;border-radius:50%;background:currentColor;flex-shrink:0;opacity:.6;}
.tile-rule{height:1px;background:var(--border);margin:0 12px;flex-shrink:0;}
.tile-content{flex:1;display:flex;align-items:center;justify-content:center;padding:12px;position:relative;}
.tile-placeholder{font-size:9px;color:var(--mut);letter-spacing:.1em;text-align:center;line-height:1.8;}
.tile-corner{position:absolute;font-family:var(--fmono);font-size:8px;color:var(--rf-acc);opacity:0;transition:opacity .15s;line-height:1;}
.tile-corner--tl{top:6px;left:6px;}
.tile-corner--br{bottom:6px;right:6px;}
.tile-expand{position:absolute;bottom:8px;right:8px;font-size:8px;color:var(--dim);letter-spacing:.1em;opacity:0;transition:opacity .15s;}
.rf-tile:hover .tile-expand{opacity:.6;}

/* ── Center ── */
.rf-center{flex:1;display:flex;flex-direction:column;overflow:hidden;position:relative;background:#030508;min-height:0;}
.spectrum-wrap{flex:1;position:relative;overflow:hidden;min-height:0;cursor:crosshair;}
#spectrumCanvas{position:absolute;inset:0;width:100%;height:100%;display:block;}
#spectrumGridCanvas{position:absolute;inset:0;pointer-events:none;z-index:1;}
#tunerCanvas{position:absolute;inset:0;pointer-events:none;z-index:3;}
#stationCanvas{position:absolute;inset:0;pointer-events:none;z-index:2;}

/* ── Waterfall ── */
.waterfall-wrap{height:120px;flex-shrink:0;position:relative;border-top:1px solid var(--border);overflow:hidden;}
#waterfallCanvas{position:absolute;inset:0;width:100%;height:100%;display:block;}
#tunerWfCanvas{position:absolute;inset:0;pointer-events:none;z-index:3;}


/* ── Pan scrollbar ── */
.spectrum-panbar{
  height:14px;flex-shrink:0;position:relative;
  background:var(--bg);border-top:1px solid var(--border);
  cursor:pointer;user-select:none;
}
.spectrum-panbar-track{
  position:absolute;top:4px;left:8px;right:8px;height:6px;
  background:var(--mut);border-radius:3px;
}
.spectrum-panbar-thumb{
  position:absolute;top:0;height:6px;
  background:var(--b2);border-radius:3px;
  transition:background .15s;cursor:grab;
  min-width:20px;
}
.spectrum-panbar-thumb:hover,.spectrum-panbar-thumb.dragging{
  background:var(--rf-acc);cursor:grabbing;
}

/* ── Scan line ── */
.spectrum-scanline{position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,.08) 2px,rgba(0,0,0,.08) 4px);z-index:2;}

/* ── Ref drag ── */
.ref-drag{position:absolute;left:0;right:0;height:8px;cursor:ns-resize;z-index:4;display:flex;align-items:center;}
.ref-drag-line{position:absolute;left:0;right:0;height:1px;background:rgba(66,212,245,.25);transition:background .15s;}
.ref-drag:hover .ref-drag-line{background:rgba(66,212,245,.6);}
.ref-drag-label{position:absolute;right:6px;font-family:var(--fmono);font-size:8px;color:var(--dim);letter-spacing:.1em;background:var(--bg);padding:0 3px;pointer-events:none;}
.ref-drag:hover .ref-drag-label{color:var(--rf-acc);}

/* ── Controls ── */
.spectrum-controls{height:36px;flex-shrink:0;display:flex;align-items:center;padding:0 12px;gap:10px;border-top:1px solid var(--border);background:var(--surface);}
.spec-ctrl-label{font-size:8px;color:var(--dim);letter-spacing:.15em;text-transform:uppercase;flex-shrink:0;}
.spec-ctrl-val{font-size:9px;color:var(--rf-acc);letter-spacing:.08em;flex-shrink:0;}
.spec-divider{width:1px;height:14px;background:var(--border);flex-shrink:0;}
.spec-band-pills{display:flex;gap:4px;flex:1;}
.spec-band{font-family:var(--fmono);font-size:8px;letter-spacing:.08em;padding:2px 7px;border:1px solid var(--b2);border-radius:2px;color:var(--dim);cursor:pointer;transition:all .15s;white-space:nowrap;}
.spec-band:hover{border-color:var(--rf-acc);color:var(--rf-acc);}
.spec-band.on{border-color:var(--rf-acc);color:var(--rf-acc);background:rgba(66,212,245,.08);}
.spec-zoom-hint{font-size:8px;color:var(--dim);letter-spacing:.08em;opacity:.5;flex-shrink:0;}
.spec-hex-btn{width:22px;height:22px;border:1px solid var(--b2);border-radius:2px;background:transparent;color:var(--dim);cursor:pointer;display:inline-flex;align-items:center;justify-content:center;transition:all .15s;flex-shrink:0;padding:0;}
.spec-hex-btn:hover{border-color:var(--rf-acc);color:var(--rf-acc);}
.spec-hex-btn.on{border-color:var(--rf-acc);color:var(--rf-acc);background:rgba(66,212,245,.1);}
.spec-hex-icon{width:13px;height:13px;display:block;fill:none;stroke:currentColor;stroke-linejoin:round;}
.spec-hex-bar{transition:opacity .15s;}


/* ── Audio tile internals ── */
.audio-tile-body{
  display:flex;flex-direction:column;
  width:100%;height:100%;
  padding:10px 12px;gap:0;overflow:hidden;
}
.audio-card{
  display:flex;flex-direction:column;gap:5px;
  flex:1;justify-content:center;overflow:hidden;
}
.audio-station-name{
  font-family:var(--fdisp);font-size:15px;
  letter-spacing:.08em;color:var(--rf-acc);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  line-height:1;
}
.audio-station-freq{
  font-family:var(--fmono);font-size:9px;
  color:var(--rf-accC);letter-spacing:.12em;
}
.audio-meta-row{
  display:flex;gap:6px;align-items:center;flex-wrap:wrap;
}
.audio-meta-pill{
  font-family:var(--fmono);font-size:7px;letter-spacing:.1em;
  padding:1px 5px;border:1px solid var(--b2);border-radius:2px;
  color:var(--dim);white-space:nowrap;
}
.audio-meta-pill.hi{border-color:var(--rf-acc);color:var(--rf-acc);}
.audio-tags{display:flex;gap:3px;flex-wrap:wrap;margin-top:1px;}
.audio-tag{
  font-family:var(--fmono);font-size:7px;letter-spacing:.08em;
  padding:1px 5px;border:1px solid var(--b2);border-radius:2px;color:var(--mut);
}
.audio-divider{height:1px;background:var(--border);flex-shrink:0;margin:4px 0;}
.audio-smeter{display:flex;flex-direction:column;gap:3px;flex-shrink:0;}
.audio-smeter-label{
  font-family:var(--fmono);font-size:7px;
  color:var(--dim);letter-spacing:.2em;text-transform:uppercase;
}
.audio-smeter-track{
  height:5px;background:var(--mut);border-radius:2px;overflow:hidden;
}
.audio-smeter-fill{
  height:100%;width:0%;border-radius:2px;
  background:linear-gradient(90deg,var(--rf-acc) 0%,var(--rf-accC) 70%,var(--rf-accB) 100%);
  transition:width .08s;
}
.audio-smeter-marks{
  display:flex;justify-content:space-between;
  font-family:var(--fmono);font-size:6px;color:var(--mut);
  letter-spacing:0;
}
.audio-status-playing .audio-station-name, .audio-station-name.audio-status-playing{color:var(--rf-acc);}
.audio-station-name.audio-status-static{color:var(--dim);}
.audio-station-name.audio-status-loading{color:var(--rf-accC);}
.audio-station-name.audio-status-error{color:var(--rf-accB);}
.audio-vol-row{
  display:flex;align-items:center;gap:6px;flex-shrink:0;
}
.audio-vol-label{
  font-family:var(--fmono);font-size:7px;
  color:var(--dim);letter-spacing:.15em;flex-shrink:0;
}
.audio-vol-slider{
  flex:1;height:2px;appearance:none;
  background:var(--b2);border-radius:2px;outline:none;cursor:pointer;
}
.audio-vol-slider::-webkit-slider-thumb{
  appearance:none;width:8px;height:8px;
  border-radius:50%;background:var(--rf-acc);cursor:pointer;
}



/* ── Signal Chain overlay ── */
#scOverlay{position:fixed;inset:0;z-index:200;background:rgba(3,5,8,.96);display:none;align-items:center;justify-content:center;backdrop-filter:blur(2px);}
#scOverlay.on{display:flex;}
.sc-box{width:calc(100vw - 48px);height:calc(100vh - 80px);background:var(--surface);border:1px solid var(--rf-acc);box-shadow:0 0 40px rgba(66,212,245,.08);display:flex;flex-direction:column;animation:tileOpen .2s ease;}
.sc-hd{height:44px;display:flex;align-items:center;padding:0 16px;gap:12px;border-bottom:1px solid var(--border);flex-shrink:0;}
.sc-title{font-family:var(--fdisp);font-size:22px;letter-spacing:.1em;color:var(--rf-acc);flex:1;}
.sc-hd-actions{display:flex;align-items:center;gap:8px;}
.sc-btn{font-family:var(--fmono);font-size:9px;letter-spacing:.1em;color:var(--dim);background:none;border:1px solid var(--b2);border-radius:2px;padding:3px 10px;cursor:pointer;transition:all .15s;white-space:nowrap;}
.sc-btn:hover{border-color:var(--rf-acc);color:var(--rf-acc);}
.sc-btn.on{border-color:var(--rf-acc);color:var(--rf-acc);background:rgba(66,212,245,.08);}
.sc-body{flex:1;display:flex;flex-direction:column;overflow:hidden;min-height:0;position:relative;}
/* Graph canvas */
#scGraphCanvas{position:absolute;inset:0;pointer-events:none;z-index:1;cursor:default;}
#scGraphCanvas.wiring{cursor:crosshair;}
#scGraphNodes{position:absolute;inset:0;z-index:2;}
/* Node cards */
.sc-node{position:absolute;width:140px;background:var(--bg);border-radius:3px;border:1px solid var(--b2);user-select:none;z-index:3;}
.sc-node.selected{box-shadow:0 0 0 1px var(--rf-acc);}
.sc-node-hd{display:flex;align-items:center;gap:5px;padding:6px 7px 5px;border-bottom:1px solid var(--border);cursor:grab;flex-shrink:0;}
.sc-node-hd:active{cursor:grabbing;}
.sc-node-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;}
.sc-node-name{font-family:var(--fmono);font-size:9px;letter-spacing:.12em;flex:1;text-transform:uppercase;}
.sc-node-power{width:13px;height:13px;border-radius:2px;border:1px solid currentColor;background:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:7px;flex-shrink:0;transition:all .15s;padding:0;}
.sc-node-remove{width:13px;height:13px;border-radius:2px;border:1px solid var(--b2);background:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:7px;color:var(--dim);flex-shrink:0;transition:all .15s;padding:0;}
.sc-node-remove:hover{border-color:#f54242;color:#f54242;}
.sc-node-body{padding:7px;display:flex;flex-direction:column;gap:5px;}
.sc-knob-row{display:flex;justify-content:space-around;gap:2px;flex-wrap:wrap;}
.sc-knob-wrap{display:flex;flex-direction:column;align-items:center;gap:2px;}
.sc-knob{width:36px;height:36px;cursor:grab;flex-shrink:0;}
.sc-knob:active{cursor:grabbing;}
.sc-knob-label{font-family:var(--fmono);font-size:6px;letter-spacing:.08em;color:var(--dim);text-transform:uppercase;text-align:center;}
.sc-knob-val{font-family:var(--fmono);font-size:7px;text-align:center;}
.sc-select{font-family:var(--fmono);font-size:7px;background:var(--panel);border:1px solid var(--b2);color:var(--dim);padding:2px 4px;border-radius:2px;outline:none;width:100%;letter-spacing:.05em;cursor:pointer;}
/* Ports */
.sc-ports{display:flex;justify-content:space-between;align-items:center;padding:0 0 5px;}
.sc-port-in,.sc-port-out{display:flex;flex-direction:column;align-items:center;gap:2px;}
.sc-port-out{align-items:flex-end;}
.sc-port{width:10px;height:10px;border-radius:50%;border:2px solid currentColor;background:var(--bg);cursor:crosshair;transition:all .15s;flex-shrink:0;}
.sc-port:hover{filter:brightness(1.5);transform:scale(1.3);}
.sc-port.active{filter:brightness(2);transform:scale(1.5);box-shadow:0 0 8px currentColor;background:currentColor;}
.sc-port.connected{background:currentColor;}
.sc-port.pending-cancel{border-color:#f54242!important;box-shadow:0 0 6px #f54242;}
.sc-port-label{font-family:var(--fmono);font-size:6px;letter-spacing:.08em;color:var(--dim);}
/* Source/Output fixed nodes */
.sc-node-fixed{position:absolute;width:64px;background:var(--bg);border:1px solid var(--b2);border-radius:3px;z-index:3;display:flex;flex-direction:column;align-items:center;padding:8px 6px;gap:6px;}
.sc-node-fixed-label{font-family:var(--fmono);font-size:8px;letter-spacing:.12em;color:var(--dim);text-transform:uppercase;text-align:center;}
.sc-node-fixed .sc-port{border-color:var(--rf-acc);}
.sc-node-fixed.out-node .sc-port{border-color:var(--rf-accC);}
/* Picker */
.sc-picker{
  position:absolute;bottom:24px;left:24px;z-index:10;
  display:flex;flex-direction:column;gap:4px;
  background:var(--surface);border:1px solid var(--border);
  border-radius:3px;box-shadow:0 4px 24px rgba(0,0,0,.5);
  cursor:default;user-select:none;overflow:hidden;
  transition:width .2s ease, min-width .2s ease;
  min-width:200px;
}
.sc-picker.collapsed{
  min-width:0!important;width:40px!important;
  border-color:transparent!important;
  background:transparent!important;
  box-shadow:none!important;
  padding:0!important;gap:0!important;
}
.sc-picker-hd{
  display:flex;align-items:center;gap:8px;
  padding:4px 8px;cursor:grab;flex-shrink:0;
  border-bottom:1px solid var(--border);
}
.sc-picker.collapsed .sc-picker-hd{
  border-bottom-color:transparent!important;padding:0!important;cursor:grab;
}
.sc-picker-hd:active{cursor:grabbing;}
.sc-picker-title{font-family:var(--fmono);font-size:8px;letter-spacing:.2em;color:var(--dim);text-transform:uppercase;flex:1;}
.sc-picker.collapsed .sc-picker-title{display:none;}
.sc-picker-body{display:flex;flex-direction:column;gap:4px;padding:8px 12px 12px;}
.sc-picker.collapsed .sc-picker-body{display:none;}
.sc-picker-hex{width:40px;height:40px;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;}
.sc-pick-row{display:flex;align-items:center;gap:5px;flex-wrap:wrap;margin-bottom:2px;}
.sc-pick-cat{font-family:var(--fmono);font-size:7px;letter-spacing:.12em;color:var(--dim);text-transform:uppercase;flex-shrink:0;width:66px;text-align:right;padding-right:6px;border-right:1px solid var(--border);}
.sc-pick-btn{font-family:var(--fmono);font-size:8px;letter-spacing:.08em;padding:3px 8px;border-radius:2px;cursor:pointer;border:1px solid currentColor;background:transparent;transition:all .15s;white-space:nowrap;}
.sc-pick-btn:hover{filter:brightness(1.4);}
/* Preset bar */
.sc-preset-bar{display:flex;align-items:center;gap:8px;padding:6px 14px;border-top:1px solid var(--border);background:var(--bg);flex-shrink:0;flex-wrap:wrap;}
.sc-preset-label{font-family:var(--fmono);font-size:8px;letter-spacing:.15em;color:var(--dim);flex-shrink:0;text-transform:uppercase;}
.sc-preset-slots{display:flex;gap:5px;flex-wrap:wrap;flex:1;}
.sc-preset-slot{font-family:var(--fmono);font-size:8px;letter-spacing:.08em;padding:3px 10px;border:1px solid var(--b2);border-radius:2px;background:transparent;color:var(--dim);cursor:pointer;transition:all .15s;white-space:nowrap;position:relative;}
.sc-preset-slot:hover{border-color:var(--rf-acc);color:var(--rf-acc);}
.sc-preset-slot.filled{border-color:rgba(66,212,245,0.4);color:var(--txt);}
.sc-preset-slot.filled:hover{border-color:var(--rf-accB);color:var(--rf-accB);}
.sc-preset-slot .slot-name{max-width:80px;overflow:hidden;text-overflow:ellipsis;display:inline-block;vertical-align:bottom;}
.sc-preset-actions{display:flex;gap:5px;flex-shrink:0;}
/* Mini tile */
.sc-mini{width:100%;height:100%;display:flex;align-items:center;justify-content:center;gap:3px;padding:4px;}
.sc-mini-mod{width:10px;height:28px;border-radius:2px;border:1px solid currentColor;}
.sc-mini-cable{width:6px;height:1px;background:var(--b2);}

/* ── Oscilloscope overlay ── */
#oscOverlay{position:fixed;inset:0;z-index:200;background:rgba(3,5,8,.96);display:none;align-items:center;justify-content:center;backdrop-filter:blur(2px);}
#oscOverlay.on{display:flex;}
.osc-box{width:calc(100vw - 48px);height:calc(100vh - 80px);background:var(--surface);border:1px solid var(--rf-acc);box-shadow:0 0 40px rgba(66,212,245,.08);display:flex;flex-direction:column;animation:tileOpen .2s ease;}
.osc-hd{height:44px;display:flex;align-items:center;padding:0 16px;gap:12px;border-bottom:1px solid var(--border);flex-shrink:0;}
.osc-title{font-family:var(--fdisp);font-size:22px;letter-spacing:.1em;color:var(--rf-acc);flex:1;}
.osc-close{font-family:var(--fmono);font-size:9px;letter-spacing:.1em;color:var(--dim);background:none;border:1px solid var(--b2);border-radius:2px;padding:3px 10px;cursor:pointer;transition:all .15s;}
.osc-close:hover{border-color:var(--rf-acc);color:var(--rf-acc);}
.osc-body{flex:1;display:flex;flex-direction:row;overflow:hidden;min-height:0;}
.osc-canvas-wrap{flex:1;display:flex;align-items:center;justify-content:center;background:#030508;position:relative;}
#oscBigCanvas{display:block;}
.osc-knob-panel{width:200px;flex-shrink:0;border-left:1px solid var(--border);background:var(--bg);display:flex;flex-direction:column;gap:0;overflow-y:auto;padding:16px 12px;gap:14px;}
.osc-knob-row{display:flex;flex-direction:column;align-items:center;gap:5px;}
.osc-knob-label{font-family:var(--fmono);font-size:8px;letter-spacing:.2em;color:var(--dim);text-transform:uppercase;}
.osc-knob-val{font-family:var(--fmono);font-size:9px;color:var(--rf-acc);letter-spacing:.08em;}
.osc-knob{position:relative;width:54px;height:54px;cursor:grab;user-select:none;}
.osc-knob:active{cursor:grabbing;}
.osc-knob svg{display:block;}
.osc-knob-divider{height:1px;background:var(--border);width:100%;flex-shrink:0;}

/* ── Overlay ── */
#tileOverlay{position:fixed;inset:0;z-index:100;background:rgba(3,5,8,.92);display:none;align-items:center;justify-content:center;backdrop-filter:blur(2px);}
#tileOverlay.on{display:flex;}
.tile-overlay-box{width:calc(100vw - 48px);height:calc(100vh - 80px);background:var(--surface);border:1px solid var(--rf-acc);box-shadow:0 0 40px rgba(66,212,245,.08);display:flex;flex-direction:column;animation:tileOpen .2s ease;}
@keyframes tileOpen{from{opacity:0;transform:scale(.97);}to{opacity:1;transform:scale(1);}}
.tile-overlay-hd{height:44px;display:flex;align-items:center;padding:0 16px;gap:12px;border-bottom:1px solid var(--border);flex-shrink:0;}
.tile-overlay-title{font-family:var(--fdisp);font-size:22px;letter-spacing:.1em;color:var(--rf-acc);flex:1;}
.tile-overlay-close{font-family:var(--fmono);font-size:9px;letter-spacing:.1em;color:var(--dim);background:none;border:1px solid var(--b2);border-radius:2px;padding:3px 10px;cursor:pointer;transition:all .15s;}
.tile-overlay-close:hover{border-color:var(--rf-acc);color:var(--rf-acc);}
.tile-overlay-body{flex:1;display:flex;align-items:center;justify-content:center;padding:24px;overflow:auto;}
.tile-overlay-placeholder{font-size:10px;color:var(--dim);letter-spacing:.15em;text-align:center;line-height:2;}
.tile-overlay-placeholder span{display:block;font-family:var(--fdisp);font-size:48px;letter-spacing:.1em;color:var(--rf-acc);opacity:.15;margin-bottom:12px;}

/* ── COMMAND modules ── */
.sc-cmd-node{
  position:absolute;width:160px;background:var(--bg);
  border-radius:3px;border:1px solid var(--b2);
  user-select:none;z-index:3;
}
.sc-cmd-node-hd{
  display:flex;align-items:center;gap:5px;
  padding:5px 7px;border-bottom:1px solid var(--border);
  cursor:grab;flex-shrink:0;
}
.sc-cmd-node-hd:active{cursor:grabbing;}
.sc-cmd-dot{width:6px;height:6px;flex-shrink:0;}/* square dot */
.sc-cmd-name{font-family:var(--fmono);font-size:9px;letter-spacing:.12em;flex:1;text-transform:uppercase;}
.sc-cmd-node-remove{width:13px;height:13px;border-radius:2px;border:1px solid var(--b2);background:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:7px;color:var(--dim);flex-shrink:0;padding:0;}
.sc-cmd-node-remove:hover{border-color:#f54242;color:#f54242;}
/* CRT display */
.sc-cmd-crt{
  background:#020804;border:1px solid rgba(0,255,80,.15);
  border-radius:2px;margin:6px 7px 4px;padding:5px 6px;
  font-family:var(--fmono);font-size:10px;letter-spacing:.05em;
  color:#00ff50;text-shadow:0 0 6px rgba(0,255,80,.8);
  min-height:28px;display:flex;align-items:center;
  position:relative;overflow:hidden;
}
.sc-cmd-crt::after{
  content:'';position:absolute;inset:0;
  background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,.15) 2px,rgba(0,0,0,.15) 4px);
  pointer-events:none;
}
.sc-cmd-crt-val{flex:1;word-break:break-all;line-height:1.3;}
.sc-cmd-crt-cursor{animation:cmdBlink .7s step-end infinite;margin-left:1px;}
@keyframes cmdBlink{50%{opacity:0;}}
/* Button row */
.sc-cmd-btns{display:flex;gap:3px;padding:0 7px 5px;flex-wrap:wrap;}
.sc-cmd-btn{
  font-family:var(--fmono);font-size:7px;letter-spacing:.05em;
  padding:2px 6px;border-radius:2px;cursor:pointer;
  border:1px solid var(--b2);background:var(--panel);
  color:var(--dim);transition:all .12s;flex-shrink:0;
}
.sc-cmd-btn:hover{border-color:currentColor;filter:brightness(1.3);}
.sc-cmd-btn.active{background:rgba(0,255,80,.12);border-color:rgba(0,255,80,.5);color:#00ff50;}
/* Expression input */
.sc-cmd-input{
  font-family:var(--fmono);font-size:8px;background:#020804;
  border:1px solid rgba(0,255,80,.2);color:#00ff50;
  padding:3px 5px;margin:0 7px 6px;border-radius:2px;
  outline:none;width:calc(100% - 14px);letter-spacing:.05em;
  box-sizing:border-box;
}
.sc-cmd-input:focus{border-color:rgba(0,255,80,.6);box-shadow:0 0 4px rgba(0,255,80,.2);}
/* Square ports */
.sc-cmd-ports{display:flex;justify-content:space-between;align-items:center;padding:0 7px 6px;}
.sc-sqport{
  width:10px;height:10px;border:2px solid currentColor;
  background:var(--bg);cursor:crosshair;transition:all .15s;
  flex-shrink:0;border-radius:1px;
}
.sc-sqport:hover{filter:brightness(1.5);transform:scale(1.3);}
.sc-sqport.active{background:currentColor;box-shadow:0 0 8px currentColor;}
.sc-sqport.connected{background:currentColor;}
.sc-sqport-label{font-family:var(--fmono);font-size:6px;letter-spacing:.08em;color:var(--dim);}
.sc-cmd-port-in,.sc-cmd-port-out{display:flex;flex-direction:column;align-items:center;gap:2px;}
/* Command picker — square button */
.sc-cmd-picker{
  position:absolute;bottom:24px;right:24px;z-index:10;
  display:flex;flex-direction:column;gap:4px;
  background:var(--surface);border:1px solid var(--border);
  border-radius:3px;box-shadow:0 4px 24px rgba(0,0,0,.5);
  cursor:default;user-select:none;overflow:hidden;
  min-width:180px;
}
.sc-cmd-picker.collapsed{
  min-width:0!important;width:40px!important;
  border-color:transparent!important;background:transparent!important;
  box-shadow:none!important;padding:0!important;gap:0!important;
}
.sc-cmd-picker-hd{
  display:flex;align-items:center;gap:8px;
  padding:4px 8px;cursor:grab;flex-shrink:0;
  border-bottom:1px solid var(--border);
}
.sc-cmd-picker.collapsed .sc-cmd-picker-hd{border-bottom-color:transparent!important;padding:0!important;}
.sc-cmd-picker-sq{width:40px;height:40px;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;}
.sc-cmd-picker-title{font-family:var(--fmono);font-size:8px;letter-spacing:.2em;color:var(--dim);text-transform:uppercase;flex:1;}
.sc-cmd-picker.collapsed .sc-cmd-picker-title{display:none;}
.sc-cmd-picker-body{display:flex;flex-direction:column;gap:3px;padding:8px 10px 10px;}
.sc-cmd-picker.collapsed .sc-cmd-picker-body{display:none;}
.sc-cmd-pick-btn{
  font-family:var(--fmono);font-size:8px;letter-spacing:.1em;
  padding:4px 10px;border-radius:2px;cursor:pointer;
  border:1px solid rgba(0,255,80,.3);background:transparent;
  color:#00c840;transition:all .15s;text-align:left;
}
.sc-cmd-pick-btn:hover{border-color:rgba(0,255,80,.8);filter:brightness(1.3);}
/* Control cables — dashed amber */
.sc-ctrl-cable{stroke-dasharray:5,4;}

/* ── Signal module square MOD ports ── */
.sc-knob-sqport{
  width:8px;height:8px;border:1px solid currentColor;
  background:var(--bg);cursor:crosshair;transition:all .12s;
  flex-shrink:0;border-radius:1px;margin-top:1px;
}
.sc-knob-sqport:hover{filter:brightness(1.5);transform:scale(1.3);}
.sc-knob-sqport.active{background:currentColor;box-shadow:0 0 6px currentColor;}
.sc-knob-sqport.connected{background:currentColor;}
.sc-knob-sqport-label{font-family:var(--fmono);font-size:5px;letter-spacing:.06em;color:var(--mut);text-transform:uppercase;}
</style>
</head>
<body>
<div id="rfProg"></div>
<div id="rfResumeBanner" class="hidden"><span class="resume-play">▶</span> CLICK TO RESUME LAST SESSION</div>

<header class="rf-header">
  <a href="../" class="rf-home">← HOME</a>
  <div class="rf-sep"></div>
  <div class="rf-title">RF</div>
  <div class="rf-ver" id="rfVer">v0.3</div>
  <div class="rf-sep"></div>
  <div class="rf-status" id="rfStatus">NOISE FLOOR — SIMULATED</div>
  <div class="rf-sep"></div>
  <!-- Live location -->
  <div class="rf-loc">
    <input class="rf-loc-input" id="locLat" type="number" step="0.0001" placeholder="LAT" title="Latitude">
    <input class="rf-loc-input" id="locLon" type="number" step="0.0001" placeholder="LON" title="Longitude">
    <button class="rf-loc-btn" id="locGpsBtn" title="Use browser GPS">◎ GPS</button>
    <button class="rf-loc-btn" id="locLoadBtn" title="Load stations at this location">LOAD</button>
    <span class="rf-loc-name" id="locName"></span>
    <select id="citySelect" style="font-family:var(--fmono);font-size:8px;background:var(--panel);border:1px solid var(--b2);color:var(--dim);padding:2px 6px;border-radius:2px;outline:none;letter-spacing:.05em;cursor:pointer;max-width:130px;">
      <option value="">— CITY PRESET —</option>
    </select>
  </div>
  <div class="rf-sep"></div>
  <div class="rf-tuner-display" id="tunerReadout">—</div>
  <div class="rf-tuner-unit">MHz</div>
  <div class="rf-sep"></div>
  <div class="rf-freq-display" id="rfFreqDisplay">88.0 — 108.0 MHz</div>
</header>

<div class="rf-workspace">
  <!-- Left -->
  <div class="rf-col">
    <div class="rf-tile" data-tile="oscilloscope">
      <div class="tile-label">Oscilloscope</div>
      <div class="tile-rule"></div>
      <div class="tile-content">
        <canvas id="oscMiniCanvas" style="width:100%;height:100%;display:block;"></canvas>
        <span class="tile-corner tile-corner--tl">╔</span>
        <span class="tile-corner tile-corner--br">╝</span>
        <span class="tile-expand">EXPAND ↗</span>
      </div>
    </div>
    <div class="rf-tile" id="audioTile" data-tile="audio" style="cursor:default;">
      <div class="tile-label">Audio</div>
      <div class="tile-rule"></div>
      <div class="tile-content" style="padding:0;">
        <div class="audio-tile-body" id="audioTileBody">
          <div class="audio-card" id="audioCard">
            <div class="audio-station-name" id="audioName">NO SIGNAL</div>
            <div class="audio-station-freq" id="audioFreq">— MHz</div>
          </div>
          <div class="audio-divider"></div>
          <div class="audio-smeter">
            <div class="audio-smeter-label">SIGNAL</div>
            <div class="audio-smeter-track">
              <div class="audio-smeter-fill" id="sMeterFill"></div>
            </div>
            <div class="audio-smeter-marks">
              <span>S1</span><span>S3</span><span>S5</span><span>S7</span><span>S9</span><span>+20</span><span>+40</span>
            </div>
          </div>
          <div class="audio-vol-row" style="margin-top:5px;">
            <span class="audio-vol-label">VOL</span>
            <input class="audio-vol-slider" id="audioVol" type="range" min="0" max="1" step="0.01" value="0.8">
          </div>
        </div>
        <span class="tile-corner tile-corner--tl">╔</span>
        <span class="tile-corner tile-corner--br">╝</span>
      </div>
    </div>
    <div class="rf-tile" data-tile="signalchain">
      <div class="tile-label">Signal Chain</div>
      <div class="tile-rule"></div>
      <div class="tile-content">
        <div class="sc-mini" id="scMiniPreview"></div>
        <span class="tile-corner tile-corner--tl">╔</span>
        <span class="tile-corner tile-corner--br">╝</span>
        <span class="tile-expand">EXPAND ↗</span>
      </div>
    </div>
  </div>

  <!-- Center -->
  <div class="rf-center">
    <div class="spectrum-with-ref" style="flex:1;display:flex;flex-direction:row;overflow:hidden;min-height:0;">
      <div class="ref-sidebar" id="refSidebar" style="width:14px;flex-shrink:0;position:relative;background:var(--bg);border-right:1px solid var(--border);cursor:pointer;user-select:none;">
        <div style="position:absolute;top:8px;bottom:8px;left:4px;width:6px;background:var(--mut);border-radius:3px;">
          <div id="refThumb" style="position:absolute;left:0;width:6px;background:var(--b2);border-radius:3px;cursor:grab;min-height:20px;transition:background .15s;"></div>
        </div>
        <span id="refDragLabel" style="display:none;position:absolute;left:18px;font-family:var(--fmono);font-size:8px;color:var(--dim);letter-spacing:.1em;background:var(--bg);padding:0 3px;pointer-events:none;white-space:nowrap;z-index:10;">REF 0 dB</span>
      </div>
      <div class="spectrum-wrap" id="specWrap">
        <canvas id="spectrumCanvas"></canvas>
        <canvas id="spectrumGridCanvas"></canvas>
        <canvas id="stationCanvas"></canvas>
        <canvas id="tunerCanvas"></canvas>
        <div class="spectrum-scanline"></div>
      </div>
    </div>
    <div class="waterfall-wrap" style="margin-left:15px;">
      <canvas id="waterfallCanvas"></canvas>
      <canvas id="tunerWfCanvas"></canvas>
    </div>
    <div class="spectrum-panbar" id="panBar" style="margin-left:15px;"><div class="spectrum-panbar-track"><div class="spectrum-panbar-thumb" id="panThumb"></div></div></div>
    <div class="spectrum-controls">
      <span class="spec-ctrl-label">BAND</span>
      <div class="spec-band-pills" id="bandPills"></div>
      <div class="spec-divider"></div>
      <span class="spec-ctrl-label">SPAN</span>
      <span class="spec-ctrl-val" id="spanVal">20 MHz</span>
      <div class="spec-divider"></div>
      <span class="spec-ctrl-label">CTR</span>
      <span class="spec-ctrl-val" id="ctrVal">98.0 MHz</span>
      <div class="spec-divider"></div>
      <span class="spec-ctrl-label">FLOOR</span>
      <span class="spec-ctrl-val" id="floorVal">−120 dBm</span>
      <div class="spec-divider"></div>
      <button class="spec-hex-btn" id="peakHoldBtn" title="Peak hold">
        <svg class="spec-hex-icon" viewBox="0 0 13 13"><polygon points="6.5,0.8 11.5,3.75 11.5,9.25 6.5,12.2 1.5,9.25 1.5,3.75" stroke-width="1.3"/><line id="peakHoldBar" class="spec-hex-bar" x1="3.5" y1="6.5" x2="9.5" y2="6.5" stroke-width="2" opacity="0"/></svg>
      </button>
      <span class="spec-ctrl-label">PEAK</span>
      <div class="spec-divider"></div>
      <button class="spec-hex-btn" id="autoFitBtn" title="Auto-fit">
        <svg class="spec-hex-icon" viewBox="0 0 13 13"><polygon points="6.5,0.8 11.5,3.75 11.5,9.25 6.5,12.2 1.5,9.25 1.5,3.75" stroke-width="1.3"/><line id="autoFitBar" class="spec-hex-bar" x1="3.5" y1="6.5" x2="9.5" y2="6.5" stroke-width="2" opacity="0"/></svg>
      </button>
      <span class="spec-ctrl-label">AUTO FIT</span>
      <div class="spec-divider"></div>
      <span class="spec-ctrl-label">ANT</span>
      <select id="antennaSelect" style="font-family:var(--fmono);font-size:8px;background:var(--panel);border:1px solid var(--b2);color:var(--dim);padding:2px 6px;border-radius:2px;outline:none;letter-spacing:.05em;cursor:pointer;">
        <option value="whip">WHIP</option>
        <option value="dipole" selected>DIPOLE</option>
        <option value="yagi">YAGI</option>
        <option value="logperiodic">LOG PERIODIC</option>
        <option value="loop">LOOP</option>
        <option value="sdr">SDR + LNA</option>
      </select>
      <div class="spec-divider"></div>
      <span class="spec-zoom-hint">SCROLL TO ZOOM · DRAG TO TUNE</span>
    </div>
  </div>

  <!-- Right -->
  <div class="rf-col rf-col--right">
    <div class="rf-tile" data-tile="transmitter">
      <div class="tile-label">Transmitter</div>
      <div class="tile-rule"></div>
      <div class="tile-content">
        <div class="tile-placeholder">MAP VIEW<br>COMING SOON</div>
        <span class="tile-corner tile-corner--tl">╔</span>
        <span class="tile-corner tile-corner--br">╝</span>
        <span class="tile-expand">EXPAND ↗</span>
      </div>
    </div>
    <div class="rf-tile" data-tile="ascii">
      <div class="tile-label">ASCII Bridge</div>
      <div class="tile-rule"></div>
      <div class="tile-content">
        <div class="tile-placeholder">WAVEFORM → ASCII<br>COMING SOON</div>
        <span class="tile-corner tile-corner--tl">╔</span>
        <span class="tile-corner tile-corner--br">╝</span>
        <span class="tile-expand">EXPAND ↗</span>
      </div>
    </div>
  </div>
</div>

<!-- Signal Chain Overlay -->
<div id="scOverlay">
  <div class="sc-box">
    <div class="sc-hd">
      <div class="sc-title">SIGNAL CHAIN</div>
      <div class="sc-hd-actions">
        <button class="sc-btn" id="scBypassAll">⬡ BYPASS ALL</button>
        <button class="sc-btn danger" id="scClearAll">✕ CLEAR ALL</button>
        <button class="sc-btn" id="scClose">✕ CLOSE</button>
      </div>
    </div>
    <div class="sc-body" id="scBody">
      <canvas id="scGraphCanvas"></canvas>
      <div id="scGraphNodes"></div>
      <div class="sc-cmd-picker" id="scCmdPicker">
        <div class="sc-cmd-picker-hd" id="scCmdPickerHd">
          <div class="sc-cmd-picker-sq" id="scCmdPickerSq">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <rect id="scSqRect" x="3" y="3" width="22" height="22" rx="2" stroke-width="1.5" fill="none" stroke="#00ff50"/>
              <text id="scSqGlyph" x="14" y="18" text-anchor="middle" font-family="Share Tech Mono,monospace" font-size="10" font-weight="bold" fill="#00ff50">⊡</text>
            </svg>
          </div>
          <span class="sc-cmd-picker-title">COMMAND</span>
        </div>
        <div class="sc-cmd-picker-body" id="scCmdPickerBody"></div>
      </div>
      <div class="sc-picker" id="scPicker">
        <div class="sc-picker-hd" id="scPickerHd">
          <div class="sc-picker-hex" id="scPickerHex">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
              <polygon id="scHexPoly" points="14,1.5 25,7.5 25,20.5 14,26.5 3,20.5 3,7.5" stroke-width="1.5" fill="none" stroke="#42d4f5"/>
              <text id="scHexGlyph" x="14" y="18" text-anchor="middle" font-family="Share Tech Mono,monospace" font-size="10" font-weight="bold" fill="#42d4f5">⬡</text>
            </svg>
          </div>
          <span class="sc-picker-title">SIGNAL</span>
        </div>
        <div class="sc-picker-body" id="scPickerBody"></div>
      </div>
    </div>
    <div class="sc-preset-bar" id="scPresetBar">
      <span class="sc-preset-label">PRESETS</span>
      <div class="sc-preset-slots" id="scPresetSlots"></div>
      <div class="sc-preset-actions">
        <button class="sc-btn" id="scExportBtn">↓ EXPORT</button>
        <button class="sc-btn" id="scImportBtn">↑ IMPORT</button>
        <input type="file" id="scImportFile" accept=".json" style="display:none;">
      </div>
    </div>
  </div>
</div>

<!-- Oscilloscope Overlay -->
<div id="oscOverlay">
  <div class="osc-box">
    <div class="osc-hd">
      <div class="osc-title">OSCILLOSCOPE — XY LISSAJOUS</div>
      <button class="osc-close" id="oscClose">✕ CLOSE</button>
    </div>
    <div class="osc-body">
      <div class="osc-canvas-wrap">
        <canvas id="oscBigCanvas"></canvas>
      </div>
      <div class="osc-knob-panel">
        <div class="osc-knob-row">
          <div class="osc-knob-label">TIME / DIV</div>
          <div class="osc-knob" id="knobTimediv" data-knob="timediv"></div>
          <div class="osc-knob-val" id="valTimediv">512</div>
        </div>
        <div class="osc-knob-divider"></div>
        <div class="osc-knob-row">
          <div class="osc-knob-label">PERSISTENCE</div>
          <div class="osc-knob" id="knobPersist" data-knob="persist"></div>
          <div class="osc-knob-val" id="valPersist">0.85</div>
        </div>
        <div class="osc-knob-divider"></div>
        <div class="osc-knob-row">
          <div class="osc-knob-label">INTENSITY</div>
          <div class="osc-knob" id="knobIntensity" data-knob="intensity"></div>
          <div class="osc-knob-val" id="valIntensity">0.80</div>
        </div>
        <div class="osc-knob-divider"></div>
        <div class="osc-knob-row">
          <div class="osc-knob-label">X GAIN</div>
          <div class="osc-knob" id="knobXgain" data-knob="xgain"></div>
          <div class="osc-knob-val" id="valXgain">1.0×</div>
        </div>
        <div class="osc-knob-divider"></div>
        <div class="osc-knob-row">
          <div class="osc-knob-label">Y GAIN</div>
          <div class="osc-knob" id="knobYgain" data-knob="ygain"></div>
          <div class="osc-knob-val" id="valYgain">1.0×</div>
        </div>
        <div class="osc-knob-divider"></div>
        <div class="osc-knob-row">
          <div class="osc-knob-label">PHASE</div>
          <div class="osc-knob" id="knobPhase" data-knob="phase"></div>
          <div class="osc-knob-val" id="valPhase">0</div>
