  // ── Preset system ─────────────────────────────────────────────
  const SC_PRESET_COUNT = 8;
  const SC_STORAGE_KEY = 'rf_sc_presets';

  function serializeChain(){
    return {
      nodes: scNodes.map(n=>({
        id:n.id, type:n.type, x:n.x, y:n.y,
        enabled:n.enabled, params:{...n.params},
        selectVal:n.selectVal
      })),
      edges: scEdges.map(e=>({...e})),
      bypass: scBypassAllState,
    };
  }

  function deserializeChain(data){
    if(!data||!data.nodes) return;
    if(!audioCtx) initAudio();
    // Clear existing
    scNodes.forEach(n=>{ const el=document.getElementById('scnode-'+n.id); if(el)el.remove(); });
    scNodes=[]; scEdges=[];
    scBypassAllState = data.bypass || false;
    document.getElementById('scBypassAll')?.classList.toggle('on', scBypassAllState);

    data.nodes.forEach(saved=>{
      const def=MODULE_DEFS[saved.type]; if(!def) return;
      const params={...saved.params};
      def.knobs.forEach(k=>{ if(params[k.id]===undefined) params[k.id]=k.def; });
      const node={
        id:saved.id, type:saved.type, x:saved.x||100, y:saved.y||100,
        enabled:saved.enabled!==false, params, selectVal:saved.selectVal||null,
        audioNode:makeWebAudioNode(saved.type,params,saved.selectVal),
      };
      scNodes.push(node);
    });
    scEdges = data.edges.map(e=>({...e}));
    rebuildAudioChain();
    // Re-render if overlay is open
    if(document.getElementById('scOverlay').classList.contains('on')){
      const body=document.getElementById('scBody');
      body.querySelectorAll('.sc-node').forEach(e=>e.remove());
      scNodes.forEach(n=>body.appendChild(createNodeEl(n)));
      drawCables(); updatePortConnectedStates();
    }
    updateScMiniPreview();
    renderPresetSlots();
  }

  function loadPresets(){
    try{ return JSON.parse(localStorage.getItem(SC_STORAGE_KEY)||'{}'); }catch(e){ return {}; }
  }
  function savePresets(presets){ localStorage.setItem(SC_STORAGE_KEY, JSON.stringify(presets)); }

  function renderPresetSlots(){
    const slots=document.getElementById('scPresetSlots'); if(!slots) return;
    const presets=loadPresets();
    slots.innerHTML='';
    for(let i=0;i<SC_PRESET_COUNT;i++){
      const p=presets[i];
      const btn=document.createElement('button');
      btn.className='sc-preset-slot'+(p?' filled':'');
      btn.title=p?`Load: ${p.name}
Right-click to save here`:'Click to save here';
      btn.innerHTML=`<span class="slot-name">${p?p.name:(i+1)}</span>`;
      btn.addEventListener('click',()=>{
        if(p){ if(confirm(`Load preset "${p.name}"?`)) deserializeChain(p.chain); }
        else {
          const name=prompt('Save preset as:','Preset '+(i+1));
          if(!name) return;
          const prs=loadPresets();
          prs[i]={name, chain:serializeChain()};
          savePresets(prs); renderPresetSlots();
        }
      });
      btn.addEventListener('contextmenu',e=>{
        e.preventDefault();
        if(p){
          const choice=confirm(`Overwrite "${p.name}" with current chain?

OK = overwrite, Cancel = delete`);
          const prs=loadPresets();
          if(choice){ const name=prompt('Save as:',p.name)||p.name; prs[i]={name,chain:serializeChain()}; }
          else delete prs[i];
          savePresets(prs); renderPresetSlots();
        } else {
          const name=prompt('Save preset as:','Preset '+(i+1));
          if(!name) return;
          const prs=loadPresets();
          prs[i]={name,chain:serializeChain()};
          savePresets(prs); renderPresetSlots();
        }
      });
      slots.appendChild(btn);
    }
  }

