  function knobAngle(name){
    const d = KNOB_DEFS[name];
    const v = knobVals[name];
    let norm;
    if(d.log){
      norm = (Math.log(v) - Math.log(d.min)) / (Math.log(d.max) - Math.log(d.min));
    } else {
      norm = (v - d.min) / (d.max - d.min);
    }
    // -135deg to +135deg
    return -135 + norm * 270;
  }

  function renderKnob(name){
    const el = document.getElementById('knob'+name.charAt(0).toUpperCase()+name.slice(1));
