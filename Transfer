    const hexGlyph = document.getElementById('scHexGlyph');
    const MODULE_COLORS=['#42d4f5','#f5f542','#42f5a1','#f54242','#c8f542','#f542a8','#a142f5','#f5a542','#42b4f5','#f542d4','#5542f5'];
    function hexLerp(a,b,t){
      const p=s=>parseInt(s.slice(1,3),16),q=s=>parseInt(s.slice(3,5),16),r=s=>parseInt(s.slice(5,7),16);
      return `rgb(${Math.round(p(a)+(p(b)-p(a))*t)},${Math.round(q(a)+(q(b)-q(a))*t)},${Math.round(r(a)+(r(b)-r(a))*t)})`;
    }
    let hexAnimId=null;
    function startHexAnim(){
      if(hexAnimId) return;
      let t=0;
      function frame(){
        t+=0.008;
        const n=MODULE_COLORS.length;
        const idx=Math.floor(t%n);
        const col=hexLerp(MODULE_COLORS[idx%n],MODULE_COLORS[(idx+1)%n],t%1);
        if(hexPoly)  hexPoly.setAttribute('stroke',col);
        if(hexGlyph) hexGlyph.setAttribute('fill',col);
        hexAnimId=requestAnimationFrame(frame);
      }
      hexAnimId=requestAnimationFrame(frame);
    }
    startHexAnim();

    // ── Collapse toggle ───────────────────────────────────────────
    let collapsed=false;
    const hexEl=document.getElementById('scPickerHex');
