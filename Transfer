</div>

<!-- Overlay -->
<div id="tileOverlay">
  <div class="tile-overlay-box">
    <div class="tile-overlay-hd">
      <div class="tile-overlay-title" id="overlayTitle">TOOL</div>
      <button class="tile-overlay-close" id="overlayClose">✕ CLOSE</button>
    </div>
    <div class="tile-overlay-body">
      <div class="tile-overlay-placeholder">
        <span id="overlayGlyph">░▒▓</span>
        <div id="overlayMsg">COMING IN A FUTURE MILESTONE</div>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  const C = RF;

  // ── Helpers ──────────────────────────────────────────────────
  function hexToRgb(hex){
    return `${parseInt(hex.slice(1,3),16)},${parseInt(hex.slice(3,5),16)},${parseInt(hex.slice(5,7),16)}`;
  }
  function setStatus(msg, color){
    const el = document.getElementById('rfStatus');
    el.textContent = msg;
    el.style.color = color || 'var(--dim)';
  }
  function setProg(pct){
    const p = document.getElementById('rfProg');
    p.style.width = pct + '%';
    if(pct >= 100) setTimeout(()=>p.style.width='0%', 400);
  }
  function disableAutoFit(){
    if(!autoFit) return;
    autoFit = false;
    document.getElementById('autoFitBtn').classList.remove('on');
    document.getElementById('autoFitBar').setAttribute('opacity','0');
  }

  // ── Accent ───────────────────────────────────────────────────
  const r = document.documentElement;
  r.style.setProperty('--rf-acc',  C.accent);
  r.style.setProperty('--rf-accB', C.accentB);
  r.style.setProperty('--rf-accC', C.accentC);
  r.style.setProperty('--rf-glow', `rgba(${hexToRgb(C.accent)},.18)`);
  r.style.setProperty('--rf-grid', `rgba(${hexToRgb(C.accent)},.06)`);
  document.title = C.title;
  document.getElementById('rfVer').textContent = `v${C.version}`;

  // ── Location state ────────────────────────────────────────────
  let userLat = C.location.lat;
  let userLon = C.location.lon;
  let userRadius = C.location.radius;

  // Init inputs from config
  document.getElementById('locLat').value = userLat.toFixed(4);
  document.getElementById('locLon').value = userLon.toFixed(4);
  document.getElementById('locName').textContent = C.location.name;

  // ── Station state ─────────────────────────────────────────────
  let stations = [];   // [{f, p, name, streamUrl, dist}]
  let stationsLoaded = false;

  // ── Radio Browser API ─────────────────────────────────────────
  const RF_PROXY = 'https://rf.ptxero.net';
  function fetchGeocode(lat, lon){
    return new Promise((resolve)=>{
      const cbName = '_geocb_' + Date.now();
      const script = document.createElement('script');
      const timer = setTimeout(()=>{
        delete window[cbName]; script.remove();
        resolve(null);
      }, 6000);
      window[cbName] = (data)=>{
        clearTimeout(timer); delete window[cbName]; script.remove();
        resolve(data);
      };
      script.src = `${RF_PROXY}/geocode?lat=${lat}&lon=${lon}&callback=${cbName}`;
      script.onerror = ()=>{ clearTimeout(timer); delete window[cbName]; resolve(null); };
      document.head.appendChild(script);
    });
  }
  function fetchStations(lat, lon, radius){
    return new Promise((resolve)=>{
      setStatus('FETCHING STATIONS…', 'var(--rf-accC)');
      setProg(20);
      const cbName = '_rbcb_' + Date.now();
      const script = document.createElement('script');
      const timer = setTimeout(()=>{
        delete window[cbName];
        script.remove();
        resolve(null);
      }, 10000);
      window[cbName] = (data)=>{
        clearTimeout(timer);
        delete window[cbName];
        script.remove();
        setProg(60);
        resolve(data && data.length ? data : null);
      };
      script.src = `${RF_PROXY}/stations?lat=${lat}&long=${lon}&radius=${radius}&callback=${cbName}`;
      script.onerror = ()=>{
        clearTimeout(timer);
        delete window[cbName];
        resolve(null);
      };
      document.head.appendChild(script);
    });
  }

  // Haversine distance in km
  function distKm(lat1, lon1, lat2, lon2){
    const R=6371, dLat=(lat2-lat1)*Math.PI/180, dLon=(lon2-lon1)*Math.PI/180;
    const a=Math.sin(dLat/2)**2+Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)**2;
    return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
  }

  // Antenna receive gain in dBi
  const ANTENNA_GAIN = {
    whip:        0,
    dipole:      2.1,
    yagi:        12,
    logperiodic: 10,
    loop:        4,
    sdr:         18,
  };

  // Realistic receive radius per antenna type (km)
  const ANTENNA_RADIUS = {
    whip:        50,
    dipole:      100,
    yagi:        200,
    logperiodic: 175,
    loop:        80,
    sdr:         300,
  };

  function getAntennaRadius(){
    const ant = document.getElementById('antennaSelect')?.value || 'dipole';
    return ANTENNA_RADIUS[ant] || 100;
  }

  // Free Space Path Loss model
  // Returns signal power in dB above noise floor (0 = at noise floor, negative = below)
  function calcSignalPower(km, freqMHz){
    const antennaType = document.getElementById('antennaSelect')
      ? document.getElementById('antennaSelect').value : 'dipole';
    const rxGain = ANTENNA_GAIN[antennaType] || 2.1;

    // Assumed transmitter ERP — 10kW typical FM = 40dBW = 70dBm
    const txPower = 70; // dBm

    // Free space path loss
    const fspl = 20*Math.log10(Math.max(1,km)) + 20*Math.log10(freqMHz) + 32.44;

    // Received signal
    const rxSignal = txPower - fspl + rxGain;

    // Noise floor reference (~-120 dBm)
    const noiseFloor = C.noiseFloor.base;
    const snr = rxSignal - noiseFloor;

    // Return dB above noise, clamped
    return Math.max(0, Math.min(60, snr));
  }

  async function loadStations(){
    const lat = parseFloat(document.getElementById('locLat').value);
    const lon = parseFloat(document.getElementById('locLon').value);
    if(isNaN(lat)||isNaN(lon)){
      setStatus('INVALID COORDINATES', 'var(--rf-accB)');
      return;
    }
    userLat = lat; userLon = lon;

    // Clear existing stations immediately on new load
    stations = [];
    stationsLoaded = false;
    noiseData = null;
    wfImageData = null;
    peakArr = null;
    drawSpectrum._p = null;
    drawStationLabels();
    userRadius = getAntennaRadius();
    document.getElementById('locLoadBtn').classList.add('loading');
    const raw = await fetchStations(lat, lon, userRadius);
    document.getElementById('locLoadBtn').classList.remove('loading');

    if(!raw){
      setStatus('COULD NOT REACH RADIO BROWSER — SIMULATED DATA ACTIVE · CHECK CONSOLE', 'var(--rf-accB)');
      stationsLoaded = false;
      stations = [];
      return;
    }

    // Parse and filter stations with valid frequency
    const parsed = [];
    for(const s of raw){
      // frequency field can be empty, kHz, or MHz
      let freq = parseFloat(s.frequency);
      if(!freq || freq <= 0){
        // Try to infer from name e.g. "WUWF 88.1"
        const m = s.name.match(/(\d{2,3}\.\d)/);
        if(m) freq = parseFloat(m[1]);
      }
      // If still no freq, skip
      if(!freq || freq <= 0) continue;
      // Normalize — if > 30000 assume Hz, if > 300 assume kHz
      if(freq > 30000) freq = freq / 1000000;
      else if(freq > 300) freq = freq / 1000;

      const sLat = parseFloat(s.geo_lat);
      const sLon = parseFloat(s.geo_long);
      const dist = (sLat&&sLon) ? distKm(lat, lon, sLat, sLon) : userRadius * 0.7;
      const power = calcSignalPower(dist, freq);

      parsed.push({
        f:        freq,
        p:        power,
        name:     (s.name||'').trim(),
        streamUrl:s.url_resolved || '',
        dist:     Math.round(dist),
        country:  s.countrycode || '',
        state:    s.state || '',
        city:     s.city || '',
        bitrate:  s.bitrate || 0,
        codec:    s.codec || '',
        homepage: s.homepage || '',
        favicon:  s.favicon || '',
        tags:     s.tags ? s.tags.split(',').map(t=>t.trim()).filter(Boolean).slice(0,5) : [],
        votes:    s.votes || 0,
        hls:      s.hls || 0,
        lat:      sLat||null,
        lon:      sLon||null,
      });
    }

    if(!parsed.length){
      fetchGeocode(lat, lon).then(geo=>{
        const place = geo && geo.display ? geo.display : `${lat.toFixed(2)}, ${lon.toFixed(2)}`;
        document.getElementById('locName').textContent = place;
        setStatus(`NO STATIONS WITH FREQUENCY DATA WITHIN ${userRadius}km OF ${place}`, 'var(--rf-accB)');
      });
      stations = [];
      stationsLoaded = false;
      return;
    }

    stations = parsed;
    stationsLoaded = true;
    setProg(100);
    setStatus(`${stations.length} STATIONS LOADED · ${lat.toFixed(2)}, ${lon.toFixed(2)}`, 'var(--rf-acc)');
    document.getElementById('locName').textContent = `${lat.toFixed(2)}, ${lon.toFixed(2)}`;
    // Reverse geocode to get place name
    fetchGeocode(lat, lon).then(geo=>{
      if(geo && geo.display){
        document.getElementById('locName').textContent = geo.display;
        setStatus(`${stations.length} STATIONS LOADED · ${geo.display}`, 'var(--rf-acc)');
      }
    });

    // Reset spectrum
    noiseData = null;
    wfImageData = null;
    peakArr = null;
    drawSpectrum._p = null;
    drawStationLabels();
  }

  // ── GPS ───────────────────────────────────────────────────────
  document.getElementById('locGpsBtn').addEventListener('click',()=>{
    if(!navigator.geolocation){
      setStatus('GEOLOCATION NOT SUPPORTED', 'var(--rf-accB)');
      return;
    }
    const btn = document.getElementById('locGpsBtn');
    btn.classList.add('loading');
    btn.textContent = '◎ …';
    setStatus('ACQUIRING GPS…', 'var(--rf-accC)');
    navigator.geolocation.getCurrentPosition(pos=>{
      userLat = pos.coords.latitude;
      userLon = pos.coords.longitude;
      document.getElementById('locLat').value = userLat.toFixed(4);
      document.getElementById('locLon').value = userLon.toFixed(4);
      btn.classList.remove('loading');
      btn.textContent = '◎ GPS';
      loadStations();
    }, err=>{
      btn.classList.remove('loading');
      btn.textContent = '◎ GPS';
      setStatus('GPS FAILED — ' + err.message.toUpperCase(), 'var(--rf-accB)');
    },{timeout:10000, maximumAge:60000});
  });

  document.getElementById('locLoadBtn').addEventListener('click', loadStations);
  document.getElementById('locLat').addEventListener('keydown', e=>{ if(e.key==='Enter') loadStations(); });
  document.getElementById('locLon').addEventListener('keydown', e=>{ if(e.key==='Enter') loadStations(); });

  // ── State ────────────────────────────────────────────────────
  let wfImageData  = null;
  let noiseData    = null;
  let noiseTime    = 0;
  let tunerFreq    = null;
  let tunerDragging = false;
  let autoFit      = false;
  let peakHold     = false;
  let peakArr      = null;
  let viewMin      = 88;
  let viewMax      = 108;
  let dbOffset     = 0;
  let refDragging  = false;
  let refDragStartY = 0;
  let refDragStartOffset = 0;
  let panDragging   = false;
  let panDragStartX = 0;
  let panDragStartMin = 0;

  // ── Canvas refs ──────────────────────────────────────────────
  const specCanvas    = document.getElementById('spectrumCanvas');
  const specCtx       = specCanvas.getContext('2d');
  const gridCanvas    = document.getElementById('spectrumGridCanvas');
  const gridCtx       = gridCanvas.getContext('2d');
  const stationCanvas = document.getElementById('stationCanvas');
  const stationCtx    = stationCanvas.getContext('2d');
  const tunerCanvas   = document.getElementById('tunerCanvas');
  const tunerCtx      = tunerCanvas.getContext('2d');
  const wfCanvas      = document.getElementById('waterfallCanvas');
  const wfCtx         = wfCanvas.getContext('2d');
  const tunerWfCv     = document.getElementById('tunerWfCanvas');
  const tunerWfCtx    = tunerWfCv.getContext('2d');
  const oscMini       = document.getElementById('oscMiniCanvas');
  const oscMiniCtx    = oscMini.getContext('2d');

  // ── Bands ────────────────────────────────────────────────────
  const BANDS = [
    { label:'AM',   min:0.53,  max:1.7,   unit:'MHz' },
    { label:'FM',   min:88,    max:108,   unit:'MHz' },
    { label:'VHF',  min:30,    max:300,   unit:'MHz' },
    { label:'UHF',  min:300,   max:3000,  unit:'MHz' },
    { label:'2.4G', min:2400,  max:2500,  unit:'MHz' },
  ];
  let currentBand = 1;

  const bandPills = document.getElementById('bandPills');
  BANDS.forEach((b,i)=>{
    const el = document.createElement('div');
    el.className = 'spec-band'+(i===currentBand?' on':'');
    el.textContent = b.label;
    el.addEventListener('click',()=>{
      currentBand = i;
      document.querySelectorAll('.spec-band').forEach(x=>x.classList.remove('on'));
      el.classList.add('on');
      const prevFreq = tunerFreq;
      viewMin = BANDS[i].min;
      viewMax = BANDS[i].max;
      if(prevFreq !== null){
        tunerFreq = Math.max(viewMin, Math.min(viewMax, prevFreq));
        document.getElementById('tunerReadout').textContent = tunerFreq.toFixed(3);
      }
      noiseData = null; wfImageData = null;
      drawGrid();
      updateBand();
      drawStationLabels();
      updatePanBar();
      if(autoFit && tunerFreq !== null) doAutoFit();
    });
    bandPills.appendChild(el);
  });

  function updateBand(){
    peakArr = null; drawSpectrum._p = null;
    const span = viewMax - viewMin;
    const ctr  = (viewMin + viewMax) / 2;
    document.getElementById('spanVal').textContent =
      span>=1000?(span/1000).toFixed(2)+' GHz':span>=1?span.toFixed(2)+' MHz':(span*1000).toFixed(1)+' kHz';
    document.getElementById('ctrVal').textContent =
      ctr>=1000?(ctr/1000).toFixed(3)+' GHz':ctr.toFixed(3)+' MHz';
    document.getElementById('rfFreqDisplay').textContent =
      `${viewMin.toFixed(2)} — ${viewMax.toFixed(2)} MHz`;
    document.getElementById('floorVal').textContent =
      `${(C.noiseFloor.base+dbOffset).toFixed(0)} dBm`;
    wfImageData = null; noiseData = null;
    drawGrid();
    updatePanBar();
  }

  viewMin = BANDS[currentBand].min;
  viewMax = BANDS[currentBand].max;
  updateBand();

  // ── Resize ───────────────────────────────────────────────────
  function resizeCanvases(){
    const sr = specCanvas.parentElement.getBoundingClientRect();
    const wr = wfCanvas.parentElement.getBoundingClientRect();
    const or = oscMini.parentElement.getBoundingClientRect();
    [specCanvas,gridCanvas,stationCanvas,tunerCanvas].forEach(cv=>{
      cv.width=sr.width; cv.height=sr.height;
    });
    [wfCanvas,tunerWfCv].forEach(cv=>{cv.width=wr.width;cv.height=wr.height;});
    oscMini.width  = or.width  || 180;
    oscMini.height = or.height || 180;
    noiseData = null; wfImageData = null;
    drawGrid();
    drawStationLabels();
  }

  // ── Noise ────────────────────────────────────────────────────
  function initNoise(W){
    const data = new Float32Array(W);
    const base = C.noiseFloor.base;
    for(let i=0;i<W;i++){
      const freq = viewMin+(i/W)*(viewMax-viewMin);
      const atm  = freq<30?(30/freq)*8:freq<100?4:0;
      const hum  = (C.noiseFloor.humidityRH/100)*1.5;
      data[i] = base + atm + 3 + hum;
    }
    return data;
  }
  function getNoiseSample(base,i,t){
    const u=()=>{let a=0,b=0;while(!a)a=Math.random();while(!b)b=Math.random();return Math.sqrt(-2*Math.log(a))*Math.cos(2*Math.PI*b);};
    return base[i]+Math.sin(t*0.001+i*0.05)*1.2+u()*2.5;
  }

  // ── Signal at frequency ───────────────────────────────────────
  // Uses real stations if loaded, falls back to simulated FM
  const SIM_STATIONS = [
    {f:88.1,p:32},{f:89.1,p:38},{f:90.7,p:35},{f:92.3,p:40},
    {f:94.1,p:36},{f:96.5,p:42},{f:99.1,p:38},{f:101.5,p:35},
    {f:103.1,p:44},{f:105.1,p:36},{f:107.3,p:38},
  ];

  function getSignalAt(freq, t){
    if(!stationsLoaded || !stations.length) return 0;
    const src = stations;
    let sig = 0;
    for(const s of src){
      const d = Math.abs(freq - s.f);
      if(d < 0.25){
        const peak = s.p * Math.exp(-(d*d)/(2*0.004));
        const shimmer = Math.sin(t*0.003+s.f)*1.5;
        sig = Math.max(sig, peak + shimmer);
      }
    }
    return sig;
  }

  // ── Station label canvas ──────────────────────────────────────
  function drawStationLabels(){
    const W = stationCanvas.width, H = stationCanvas.height;
    stationCtx.clearRect(0,0,W,H);
    if(!W||!H) return;

    if(!stationsLoaded || !stations.length) return;
    const src = stations;
    const dbMin = C.spectrum.dbMin+dbOffset;
    const dbMax = C.spectrum.dbMax+dbOffset;
    const dbRange = dbMax-dbMin;

    // Get actual peak Y from spectrum data if available
    const specData = drawSpectrum._p;
    const dpr = window.devicePixelRatio || 1;

    for(const s of src){
      if(s.f < viewMin || s.f > viewMax) continue;
      const x = ((s.f-viewMin)/(viewMax-viewMin))*W;

      // Find actual peak Y from rendered spectrum data
      let peakY;
      if(specData && specData.length === W){
        const xi = Math.round(x);
        const dbMin2 = C.spectrum.dbMin+dbOffset, dbMax2 = C.spectrum.dbMax+dbOffset, dbRange2 = dbMax2-dbMin2;
        // Sample a few pixels around the station frequency for true peak
        let peakDb = -999;
        for(let di=-3;di<=3;di++){
          const ii = Math.max(0,Math.min(W-1,xi+di));
          if(specData[ii] > peakDb) peakDb = specData[ii];
        }
        peakY = Math.max(6, H - ((peakDb-dbMin2)/dbRange2)*H);
      } else {
        peakY = Math.max(6, H - (s.p/60)*H*0.85);
      }

      // ▶ icon pinned just above the actual peak tip
      if(s.streamUrl){
        stationCtx.font = `bold ${Math.round(11*dpr)/dpr}px "Share Tech Mono", monospace`;
        stationCtx.fillStyle = `rgba(${hexToRgb(C.accentC)},0.95)`;
        stationCtx.fillText('▶', x - 5, peakY - 6);
      }

      // Station name label just below the icon
      const label = s.name ? s.name.substring(0,10).toUpperCase() : s.f.toFixed(1);
      const labelY = peakY + (s.streamUrl ? 8 : 2);
      stationCtx.font = `${Math.round(8*dpr)/dpr}px "Share Tech Mono", monospace`;
      const tw = stationCtx.measureText(label).width;
      const lx = Math.max(2, Math.min(W-tw-4, x-tw/2));
      stationCtx.fillStyle = 'rgba(3,5,8,0.75)';
      stationCtx.fillRect(lx-1, labelY-9, tw+4, 10);
      stationCtx.fillStyle = `rgba(${hexToRgb(C.accent)},0.6)`;
      stationCtx.fillText(label, lx+1, labelY);

      // Tick mark at station frequency
      stationCtx.strokeStyle = `rgba(${hexToRgb(C.accent)},0.2)`;
      stationCtx.lineWidth = 1;
      stationCtx.setLineDash([2,3]);
      stationCtx.beginPath();
      stationCtx.moveTo(x, labelY+2);
      stationCtx.lineTo(x, H);
      stationCtx.stroke();
      stationCtx.setLineDash([]);
    }
  }

  // ── Draw spectrum ─────────────────────────────────────────────
  function drawSpectrum(t){
    const W=specCanvas.width, H=specCanvas.height;
    if(!W||!H) return;
    if(!noiseData||noiseData.length!==W) noiseData=initNoise(W);
    const dbMin=C.spectrum.dbMin+dbOffset, dbMax=C.spectrum.dbMax+dbOffset, dbRange=dbMax-dbMin;
    const frame=new Float32Array(W);
    for(let i=0;i<W;i++){
      const freq=viewMin+(i/W)*(viewMax-viewMin);
      frame[i]=getNoiseSample(noiseData,i,t)+getSignalAt(freq,t);
    }
    if(!drawSpectrum._p||drawSpectrum._p.length!==W) drawSpectrum._p=new Float32Array(frame);
    const sm=C.spectrum.smoothing;
    for(let i=0;i<W;i++) drawSpectrum._p[i]=drawSpectrum._p[i]*sm+frame[i]*(1-sm);
    const data=drawSpectrum._p;
    specCtx.clearRect(0,0,W,H);
    specCtx.beginPath();
    specCtx.moveTo(0,H);
    for(let i=0;i<W;i++){
      const y=H-((data[i]-dbMin)/dbRange)*H;
      i===0?specCtx.lineTo(0,y):specCtx.lineTo(i,y);
    }
    specCtx.lineTo(W,H);specCtx.closePath();
    const g=specCtx.createLinearGradient(0,0,0,H);
    g.addColorStop(0,`rgba(${hexToRgb(C.accent)},0.5)`);
    g.addColorStop(0.4,`rgba(${hexToRgb(C.accent)},0.15)`);
    g.addColorStop(1,`rgba(${hexToRgb(C.accent)},0.02)`);
    specCtx.fillStyle=g; specCtx.fill();
    specCtx.beginPath();
    for(let i=0;i<W;i++){
      const y=H-((data[i]-dbMin)/dbRange)*H;
      i===0?specCtx.moveTo(0,y):specCtx.lineTo(i,y);
    }
    specCtx.strokeStyle=C.accent; specCtx.lineWidth=1.5;
    specCtx.shadowColor=C.accent; specCtx.shadowBlur=6;
    specCtx.stroke(); specCtx.shadowBlur=0;
    if(peakHold){
      if(!peakArr||peakArr.length!==W) peakArr=new Float32Array(data);
      else for(let i=0;i<W;i++) if(data[i]>peakArr[i]) peakArr[i]=data[i];
      drawPeakHold();
    }
    return data;
  }

  function drawPeakHold(){
    if(!peakHold||!peakArr) return;
    const W=specCanvas.width, H=specCanvas.height;
    const dbMin=C.spectrum.dbMin+dbOffset, dbMax=C.spectrum.dbMax+dbOffset, dbRange=dbMax-dbMin;
    specCtx.beginPath();
    for(let i=0;i<W;i++){
      const y=H-((peakArr[i]-dbMin)/dbRange)*H;
      i===0?specCtx.moveTo(i,y):specCtx.lineTo(i,y);
    }
    specCtx.strokeStyle=`rgba(${hexToRgb(C.accentC)},0.7)`;
    specCtx.lineWidth=1; specCtx.setLineDash([2,3]);
    specCtx.stroke(); specCtx.setLineDash([]);
  }


  // ── Pan scrollbar ─────────────────────────────────────────────
  function updatePanBar(){
    const b = BANDS[currentBand];
    const bSpan = b.max - b.min;
    const vSpan = viewMax - viewMin;
    const panBar = document.getElementById('panBar');
    const thumb  = document.getElementById('panThumb');
    if(!panBar||!thumb) return;
    const trackW = panBar.offsetWidth - 16;
    const thumbW = Math.max(20, (vSpan/bSpan)*trackW);
    const thumbX = 8 + ((viewMin-b.min)/bSpan)*trackW;
    thumb.style.width = thumbW + 'px';
    thumb.style.left  = thumbX + 'px';
  }

  // ── Draw grid ─────────────────────────────────────────────────
  function drawGrid(){
    const W=gridCanvas.width, H=gridCanvas.height;
    if(!W||!H) return;
    gridCtx.clearRect(0,0,W,H);
    const dbMin=C.spectrum.dbMin+dbOffset, dbMax=C.spectrum.dbMax+dbOffset, dbRange=dbMax-dbMin;
    gridCtx.strokeStyle=`rgba(${hexToRgb(C.accent)},0.06)`;
    gridCtx.lineWidth=1;
    for(let db=Math.ceil(dbMin/10)*10;db<=dbMax;db+=10){
      const y=H-((db-dbMin)/dbRange)*H;
      gridCtx.beginPath(); gridCtx.moveTo(0,y); gridCtx.lineTo(W,y); gridCtx.stroke();
      gridCtx.fillStyle=`rgba(${hexToRgb(C.accent)},0.3)`;
      gridCtx.font='8px monospace';
      gridCtx.fillText(`${db}`,4,y-2);
    }
    for(let i=0;i<=10;i++){
      const x=(i/10)*W;
      gridCtx.beginPath(); gridCtx.moveTo(x,0); gridCtx.lineTo(x,H); gridCtx.stroke();
      const freq=viewMin+(i/10)*(viewMax-viewMin);
      const lbl=freq>=1000?(freq/1000).toFixed(1)+'G':freq>=1?freq.toFixed(1)+'M':(freq*1000).toFixed(0)+'k';
      gridCtx.fillStyle=`rgba(${hexToRgb(C.accent)},0.3)`;
      gridCtx.font='8px monospace';
      if(i<10) gridCtx.fillText(lbl,x+3,H-4);
    }
    
  }

  // ── Draw tuner ────────────────────────────────────────────────
  function drawTuner(){
    const W=tunerCanvas.width, H=tunerCanvas.height;
    tunerCtx.clearRect(0,0,W,H);
    if(tunerFreq===null) return;
    const x=((tunerFreq-viewMin)/(viewMax-viewMin))*W;
    if(x<0||x>W) return;

    // Check if tuner is on a real station
    const snap = getNearestStation(tunerFreq);
    const lineColor = snap ? C.accentC : C.accentB;

    tunerCtx.strokeStyle=lineColor; tunerCtx.lineWidth=1;
    tunerCtx.setLineDash([4,3]);
    tunerCtx.beginPath(); tunerCtx.moveTo(x,0); tunerCtx.lineTo(x,H); tunerCtx.stroke();
    tunerCtx.setLineDash([]);
    tunerCtx.fillStyle=lineColor;
    tunerCtx.beginPath(); tunerCtx.moveTo(x,8); tunerCtx.lineTo(x-5,0); tunerCtx.lineTo(x+5,0);
    tunerCtx.closePath(); tunerCtx.fill();

    // Label — show station name if snapped
    const label = snap
      ? `${(snap.name||snap.f.toFixed(1)).substring(0,12)} · ${tunerFreq.toFixed(1)} MHz`
      : `${tunerFreq.toFixed(3)} MHz`;
    tunerCtx.font='bold 10px monospace';
    const tw=tunerCtx.measureText(label).width;
    const lx=Math.max(2,Math.min(W-tw-8,x-tw/2-4));
    tunerCtx.fillStyle='rgba(3,5,8,0.88)';
    tunerCtx.fillRect(lx-2,10,tw+8,16);
    tunerCtx.strokeStyle=lineColor; tunerCtx.lineWidth=1;
    tunerCtx.strokeRect(lx-2,10,tw+8,16);
    tunerCtx.fillStyle=lineColor;
    tunerCtx.fillText(label,lx+2,23);

    const W2=tunerWfCv.width, H2=tunerWfCv.height;
    tunerWfCtx.clearRect(0,0,W2,H2);
    const x2=((tunerFreq-viewMin)/(viewMax-viewMin))*W2;
    tunerWfCtx.strokeStyle=lineColor; tunerWfCtx.lineWidth=1;
    tunerWfCtx.setLineDash([3,2]);
    tunerWfCtx.beginPath(); tunerWfCtx.moveTo(x2,0); tunerWfCtx.lineTo(x2,H2); tunerWfCtx.stroke();
    tunerWfCtx.setLineDash([]);
  }

  // Find nearest station within 0.2 MHz
  function getNearestStation(freq){
    if(!stationsLoaded || !stations.length) return null;
    const src = stations;
    let best = null, bestD = 0.2;
    for(const s of src){
      const d = Math.abs(s.f - freq);
      if(d < bestD){ bestD=d; best=s; }
    }
    return best;
  }

  // ── Waterfall ─────────────────────────────────────────────────
  function drawWaterfall(frameData){
    const W=wfCanvas.width, H=wfCanvas.height;
    if(!W||!H||!frameData) return;
    if(!wfImageData||wfImageData.width!==W||wfImageData.height!==H) wfImageData=wfCtx.createImageData(W,H);
    const d=wfImageData.data;
    d.copyWithin(W*4,0,W*(H-1)*4);
    const dbMin=C.spectrum.dbMin, dbMax=C.spectrum.dbMax, dbRange=dbMax-dbMin;
    for(let i=0;i<W;i++){
      const n=Math.max(0,Math.min(1,(frameData[i]-dbMin)/dbRange));
      d[i*4]  =Math.round(n>0.7?(n-0.7)/0.3*255:0);
      d[i*4+1]=Math.round(n>0.3?Math.min(1,(n-0.3)/0.4)*212:0);
      d[i*4+2]=Math.round(n*245);
      d[i*4+3]=255;
    }
    wfCtx.putImageData(wfImageData,0,0);
  }

  // ── Oscilloscope state ────────────────────────────────────────
  let oscTimediv    = 512;
  let oscPersist    = 0.85;
  let oscIntensity  = 0.8;
  let oscXgain      = 1.0;
  let oscYgain      = 1.0;
  let oscPhase      = 0;
  let oscMiniPersistBuf = null;

  function getLissajousData(){
    // Returns {xArr, yArr} from analysers, or null if no audio
    if(!analyserL || !analyserR) return null;
    const N = analyserL.fftSize;
    const xArr = new Float32Array(N);
    const yArr = new Float32Array(N);
    analyserL.getFloatTimeDomainData(xArr);
    analyserR.getFloatTimeDomainData(yArr);
    // Check if there's actually signal (not silence)
    let rms = 0;
    for(let i=0;i<N;i++) rms += xArr[i]*xArr[i];
    rms = Math.sqrt(rms/N);
    if(rms < 0.001) return null;
    return {xArr, yArr};
  }

  function drawLissajous(ctx, W, H, data, samples, xgain, ygain, phase, alpha, lineW){
    const cx=W/2, cy=H/2, r=Math.min(W,H)*0.44;
    ctx.beginPath();
    let first=true;
    const len = Math.min(samples, data.xArr.length);
    for(let i=0;i<len;i++){
      const xi = i;
      const yi = (i + phase) % data.xArr.length;
      const x = cx + data.xArr[xi] * xgain * r;
      const y = cy - data.yArr[yi] * ygain * r;
      if(first){ ctx.moveTo(x,y); first=false; } else { ctx.lineTo(x,y); }
    }
    ctx.strokeStyle = `rgba(${hexToRgb(C.accent)},${alpha})`;
    ctx.lineWidth = lineW;
    ctx.shadowColor = C.accent;
    ctx.shadowBlur = lineW > 1 ? 8 : 3;
    ctx.stroke();
    ctx.shadowBlur = 0;
  }

  function drawNoiseBlob(ctx, W, H, t, alpha){
    // Static noise = filled blob of dots
    const cx=W/2, cy=H/2, r=Math.min(W,H)*0.3;
    ctx.beginPath();
    for(let i=0;i<80;i++){
      const a=(i/80)*Math.PI*2+t*0.001;
      const rr=r*(0.2+Math.random()*0.8);
      const x=cx+Math.cos(a)*rr*(0.5+Math.random()*0.5);
      const y=cy+Math.sin(a)*rr*(0.5+Math.random()*0.5);
      ctx.moveTo(x+1,y); ctx.arc(x,y,0.8,0,Math.PI*2);
    }
    ctx.fillStyle=`rgba(${hexToRgb(C.accent)},${alpha*0.4})`;
    ctx.fill();
  }

  // ── Oscilloscope mini ─────────────────────────────────────────
  function drawOscMini(t){
    const W=oscMini.width, H=oscMini.height;
    if(!W||!H) return;

    // Persistence — fade previous frame
    if(!oscMiniPersistBuf){
      oscMiniCtx.clearRect(0,0,W,H);
    } else {
      oscMiniCtx.fillStyle=`rgba(3,5,8,${1-oscPersist*0.3})`;
      oscMiniCtx.fillRect(0,0,W,H);
    }
    oscMiniPersistBuf = true;

    // Grid
    oscMiniCtx.strokeStyle=`rgba(${hexToRgb(C.accent)},0.06)`;
    oscMiniCtx.lineWidth=1;
    oscMiniCtx.setLineDash([2,3]);
    for(let i=1;i<4;i++){
      oscMiniCtx.beginPath();oscMiniCtx.moveTo(0,H*i/4);oscMiniCtx.lineTo(W,H*i/4);oscMiniCtx.stroke();
      oscMiniCtx.beginPath();oscMiniCtx.moveTo(W*i/4,0);oscMiniCtx.lineTo(W*i/4,H);oscMiniCtx.stroke();
    }
    oscMiniCtx.setLineDash([]);
    // Crosshair
    oscMiniCtx.strokeStyle=`rgba(${hexToRgb(C.accent)},0.12)`;
    oscMiniCtx.beginPath();oscMiniCtx.moveTo(W/2,0);oscMiniCtx.lineTo(W/2,H);oscMiniCtx.stroke();
    oscMiniCtx.beginPath();oscMiniCtx.moveTo(0,H/2);oscMiniCtx.lineTo(W,H/2);oscMiniCtx.stroke();

    const data = getLissajousData();
    if(data){
      drawLissajous(oscMiniCtx, W, H, data, oscTimediv, oscXgain, oscYgain, oscPhase, oscIntensity*0.7, 1);
    } else {
      drawNoiseBlob(oscMiniCtx, W, H, t, 0.5);
    }
  }


  // ── Audio Engine ──────────────────────────────────────────────
  let audioCtx = null;
  let staticNode = null;
  let staticGain = null;
  let streamSource = null;
  let streamGain = null;
  let streamAudio = null;
  let currentStreamUrl = null;
  let audioVolume = 0.8;
  let signalStrength = 0; // 0-1
  let analyserL = null;
  let analyserR = null;
  let splitter = null;
  let masterGain = null;

  function initAudio(){
    if(audioCtx) return;
    audioCtx = new (window.AudioContext || window.webkitAudioContext)();

    // Static noise generator
    const bufferSize = audioCtx.sampleRate * 2;
    const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
    const data = buffer.getChannelData(0);
    for(let i=0;i<bufferSize;i++) data[i]=(Math.random()*2-1);
    staticNode = audioCtx.createBufferSource();
    staticNode.buffer = buffer;
    staticNode.loop = true;

    // Filter static to sound like RF noise — bandpass ~1-8kHz
    const bpf = audioCtx.createBiquadFilter();
    bpf.type = 'bandpass';
    bpf.frequency.value = 3000;
    bpf.Q.value = 0.5;

    staticGain = audioCtx.createGain();
    staticGain.gain.value = 0;

    staticNode.connect(bpf);
    bpf.connect(staticGain);
    staticGain.connect(audioCtx.destination);
    staticNode.start();

    // Stream gain node — feeds into signal chain
    streamGain = audioCtx.createGain();
    streamGain.gain.value = 0;

    // Master output gain — end of chain → destination
    masterGain = audioCtx.createGain();
    masterGain.gain.value = 1;
    masterGain.connect(audioCtx.destination);

    // Analyser nodes for oscilloscope — tap from masterGain
    splitter = audioCtx.createChannelSplitter(2);
    analyserL = audioCtx.createAnalyser();
    analyserR = audioCtx.createAnalyser();
    analyserL.fftSize = 2048;
    analyserR.fftSize = 2048;
    analyserL.smoothingTimeConstant = 0;
    analyserR.smoothingTimeConstant = 0;
    masterGain.connect(splitter);
    splitter.connect(analyserL, 0);
    splitter.connect(analyserR, 1);

    // Initial chain: streamGain → masterGain (no effects yet)
    rebuildAudioChain();
  }

  function setAudioVolume(v){
    audioVolume = v;
    updateAudioMix();
  }

  function updateAudioMix(){
    if(!audioCtx) return;
    const sig = Math.max(0, Math.min(1, signalStrength));
    // Squelch — below 0.4 signal strength, full static. Above 0.7, no static at all.
    // Between 0.4 and 0.7, smooth crossfade.
    const squelchLow  = 0.4;
    const squelchHigh = 0.7;
    const cleanSig = Math.max(0, Math.min(1, (sig - squelchLow) / (squelchHigh - squelchLow)));
    const staticAmt = Math.max(0, 1 - cleanSig);
    staticGain.gain.setTargetAtTime(staticAmt * audioVolume * 0.3, audioCtx.currentTime, 0.08);
    streamGain.gain.setTargetAtTime(cleanSig, audioCtx.currentTime, 0.08);
    if(masterGain) masterGain.gain.setTargetAtTime(audioVolume, audioCtx.currentTime, 0.08);
  }

  function calcSignalStrength(freq){
    // Returns 0-1 based on how close tuner is to a station peak
    const src = stationsLoaded ? stations : SIM_STATIONS;
    let best = 0;
    for(const s of src){
      const d = Math.abs(freq - s.f);
      if(d < 0.3){
        // Bell curve — at center freq, strength = s.p normalized to 0-1
        const match = Math.exp(-(d*d)/(2*0.005));
        const strength = (s.p / 60) * match;
        if(strength > best) best = strength;
      }
    }
    return Math.min(1, best);
  }

  let tuneDebounceTimer = null;
  let pendingNextAudio = null;   // preloading next stream
  let pendingNextStation = null; // station being preloaded

  async function tuneAudio(freq){
    if(!audioCtx) initAudio();
    if(audioCtx.state === 'suspended') await audioCtx.resume();

    signalStrength = calcSignalStrength(freq);
    updateAudioLcd(freq);
    updateAudioMix();

    const snap = getNearestStation(freq);
    clearTimeout(tuneDebounceTimer);

    if(snap && signalStrength > 0.3 && snap.streamUrl){
      if(currentStreamUrl !== snap.streamUrl){
        // Stop current stream — static takes over via updateAudioMix
        stopStream();
        preloadStream(snap);
      }
    } else {
      abortPendingStream();
      stopStream();
    }
  }

  function preloadStream(station){
    // Cancel any in-progress preload for a different station
    if(pendingNextAudio && pendingNextStation?.streamUrl !== station.streamUrl){
      pendingNextAudio.src = '';
      pendingNextAudio = null;
      pendingNextStation = null;
    }
    if(pendingNextStation?.streamUrl === station.streamUrl) return; // already preloading this one
    currentStreamUrl = null; // ensure reload is never blocked

    const next = new Audio();
    next.crossOrigin = 'anonymous';
    next.src = station.streamUrl;
    next.volume = 1;
    pendingNextAudio   = next;
    pendingNextStation = station;

    next.addEventListener('canplay', async ()=>{
      // Only cut over if this is still the desired station
      if(pendingNextAudio !== next) return;
      try{
        stopStream();
        currentStreamUrl   = station.streamUrl;
        pendingNextAudio   = null;
        pendingNextStation = null;
        streamAudio  = next;
        streamSource = audioCtx.createMediaElementSource(streamAudio);
        streamSource.connect(streamGain);
        await streamAudio.play();
        setAudioStatus('▶ ' + (station.name||station.f.toFixed(1)).substring(0,14).toUpperCase(), 'playing');
      }catch(e){
        setAudioStatus('STREAM ERROR', 'error');
        currentStreamUrl = null;
      }
    },{once:true});

    next.addEventListener('error', ()=>{
      if(pendingNextAudio === next){ pendingNextAudio=null; pendingNextStation=null; }
      setAudioStatus('STREAM UNAVAILABLE', 'error');
    },{once:true});
  }

  function abortPendingStream(){
    if(pendingNextAudio){
      pendingNextAudio.src = '';
      pendingNextAudio   = null;
      pendingNextStation = null;
    }
  }

  function loadStream(station){ preloadStream(station); }

  function stopStream(){
    if(streamAudio){
      streamAudio.pause();
      streamAudio.src = '';
      streamAudio = null;
    }
    if(streamSource){
      try{ streamSource.disconnect(); }catch(e){}
      streamSource = null;
    }
    currentStreamUrl = null;
    // Re-open static — let updateAudioMix handle levels based on signalStrength
    updateAudioMix();
  }

  function updateAudioLcd(freq){
    const snap = getNearestStation(freq);
    const card = document.getElementById('audioCard');
    const pct = Math.round(signalStrength * 100);
    document.getElementById('sMeterFill').style.width = pct + '%';

    if(!snap || signalStrength <= 0.15){
      document.getElementById('audioName').textContent = 'NO SIGNAL';
      document.getElementById('audioFreq').textContent = freq.toFixed(3) + ' MHz';
      // Remove dynamic rows
      card.querySelectorAll('.audio-meta-row,.audio-tags').forEach(el=>el.remove());
      return;
    }

    document.getElementById('audioName').textContent =
      (snap.name||snap.f.toFixed(1)).substring(0,18).toUpperCase();
    document.getElementById('audioFreq').textContent = snap.f.toFixed(1) + ' MHz';

    // Remove old dynamic rows
    card.querySelectorAll('.audio-meta-row,.audio-tags').forEach(el=>el.remove());

    // Meta pills row 1 — dist, country, bitrate/codec
    const pills = [];
    if(snap.dist) pills.push({label: snap.dist+'km', hi: false});
    if(snap.country) pills.push({label: snap.country, hi: false});
    if(snap.state) pills.push({label: snap.state.substring(0,12), hi: false});
    if(snap.bitrate) pills.push({label: snap.bitrate+'kbps', hi: true});
    if(snap.codec) pills.push({label: snap.codec, hi: true});
    if(snap.hls) pills.push({label: 'HLS', hi: true});

    if(pills.length){
      const row = document.createElement('div');
      row.className = 'audio-meta-row';
      pills.forEach(p=>{
        const el = document.createElement('span');
        el.className = 'audio-meta-pill' + (p.hi ? ' hi' : '');
        el.textContent = p.label;
        row.appendChild(el);
      });
      card.appendChild(row);
    }

    // Tags row
    if(snap.tags && snap.tags.length){
      const row = document.createElement('div');
      row.className = 'audio-tags';
      snap.tags.forEach(t=>{
        const el = document.createElement('span');
        el.className = 'audio-tag';
        el.textContent = t;
        row.appendChild(el);
      });
      card.appendChild(row);
    }
  }

  function setAudioStatus(msg, cls){
    // Status reflected via audioName color class instead of separate element
    const name = document.getElementById('audioName');
    if(name){
      name.className = 'audio-station-name audio-status-' + (cls||'static');
    }
  }

  // S-meter animation loop
  function updateSMeter(){
    if(!tunerFreq) return;
    // Add slight flicker to signal strength
    const base = calcSignalStrength(tunerFreq);
    const flicker = base > 0.1 ? base + (Math.random()-0.5)*0.04 : 0;
    const pct = Math.round(Math.max(0,Math.min(1,flicker))*100);
    document.getElementById('sMeterFill').style.width = pct + '%';
  }

  // Volume control
  document.getElementById('audioVol').addEventListener('input', e=>{
    setAudioVolume(parseFloat(e.target.value));
  });

  // ── Loop ─────────────────────────────────────────────────────
  let frameCount=0;
  function loop(t){
    requestAnimationFrame(loop);
    frameCount++; noiseTime=t;
    const fd=drawSpectrum(t);
    if(frameCount%2===0) drawWaterfall(fd);
    drawTuner();
    drawOscMini(t);
    if(frameCount%4===0) updateSMeter();
  }

  // ── Tuner interaction ─────────────────────────────────────────
  function freqFromX(x){ return viewMin+(x/specCanvas.width)*(viewMax-viewMin); }
  function clampFreq(f){ return Math.max(viewMin,Math.min(viewMax,f)); }

  function doAutoFit(){
    if(tunerFreq===null) return;
    const b=BANDS[currentBand];
    const bSpan=b.max-b.min;
    const fitSpan=Math.max(0.5,bSpan*0.2);
    viewMin=tunerFreq-fitSpan/2; viewMax=tunerFreq+fitSpan/2;
    if(viewMin<b.min){viewMin=b.min;viewMax=b.min+fitSpan;}
    if(viewMax>b.max){viewMax=b.max;viewMin=b.max-fitSpan;}
    if(drawSpectrum._p){
      const W=specCanvas.width;
      let peakDb=C.spectrum.dbMin;
      const cx=Math.round(((tunerFreq-viewMin)/(viewMax-viewMin))*W);
      const rad=Math.round(W*0.1);
      for(let i=Math.max(0,cx-rad);i<Math.min(W,cx+rad);i++){
        if(drawSpectrum._p[i]>peakDb) peakDb=drawSpectrum._p[i];
      }
      const targetDb=C.spectrum.dbMax-0.75*(C.spectrum.dbMax-C.spectrum.dbMin);
      dbOffset=Math.max(-60,Math.min(60,targetDb-peakDb));
      document.getElementById('refDragLabel').textContent=`REF ${dbOffset>=0?'+':''}${dbOffset.toFixed(0)} dB`;
    }
    noiseData=null; wfImageData=null;
    drawGrid(); updateBand(); drawStationLabels();
  }

  function setTuner(freq){
    tunerFreq=clampFreq(freq);
    document.getElementById('tunerReadout').textContent=tunerFreq.toFixed(3);
    if(autoFit) doAutoFit();
    tuneAudio(tunerFreq);
    // Debounced save so rapid dragging doesn't hammer localStorage
    clearTimeout(setTuner._saveTimer);
    setTuner._saveTimer = setTimeout(saveState, 800);
  }

  // ── Ref sidebar ───────────────────────────────────────────────
  const refSidebar  = document.getElementById('refSidebar');
  const refThumb    = document.getElementById('refThumb');
  const refDragLabel = document.getElementById('refDragLabel');

  function updateRefThumb(){
    const trackH = refSidebar.offsetHeight - 16;
    const thumbH = Math.max(20, trackH * 0.15);
    const norm   = (dbOffset + 60) / 120;
    const thumbY = 8 + (1 - norm) * (trackH - thumbH);
    refThumb.style.height = thumbH + 'px';
    refThumb.style.top    = thumbY + 'px';
  }

  refSidebar.addEventListener('mouseenter', ()=>{ refDragLabel.style.display='block'; });
  refSidebar.addEventListener('mouseleave', ()=>{ if(!refDragging) refDragLabel.style.display='none'; });

  refThumb.addEventListener('mousedown', e=>{
    refDragging=true; refDragStartY=e.clientY; refDragStartOffset=dbOffset;
    refThumb.style.background='var(--rf-acc)';
    e.preventDefault(); e.stopPropagation();
  });

  window.addEventListener('mousemove', e=>{
    if(!refDragging) return;
    disableAutoFit();
