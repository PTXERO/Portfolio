  // ── Persistence ───────────────────────────────────────────────
  const PERSIST_KEY = 'ptxero_rf_state';

  function saveState(){
    try{
      const state = {
        lat:    parseFloat(document.getElementById('locLat').value)||C.location.lat,
        lon:    parseFloat(document.getElementById('locLon').value)||C.location.lon,
        locName:document.getElementById('locName').textContent||'',
        viewMin, viewMax, dbOffset, currentBand,
        tunerFreq, autoFit, peakHold,
        antenna: document.getElementById('antennaSelect').value,
        volume:  parseFloat(document.getElementById('audioVol').value),
        scChain: serializeChain(),
        scBypass: scBypassAllState,
      };
      localStorage.setItem(PERSIST_KEY, JSON.stringify(state));
    }catch(e){}
  }

  function restoreState(){
    try{
      const raw = localStorage.getItem(PERSIST_KEY);
      if(!raw) return false;
      const s = JSON.parse(raw);

      // Location
      if(s.lat && s.lon){
        document.getElementById('locLat').value = parseFloat(s.lat).toFixed(4);
        document.getElementById('locLon').value = parseFloat(s.lon).toFixed(4);
        userLat = s.lat; userLon = s.lon;
      }
      if(s.locName) document.getElementById('locName').textContent = s.locName;

      // Spectrum view
      if(s.currentBand !== undefined){
        currentBand = s.currentBand;
        document.querySelectorAll('.spec-band').forEach((el,i)=>el.classList.toggle('on',i===currentBand));
      }
      if(s.viewMin !== undefined) viewMin = s.viewMin;
      if(s.viewMax !== undefined) viewMax = s.viewMax;
      if(s.dbOffset !== undefined){
        dbOffset = s.dbOffset;
        document.getElementById('refDragLabel').textContent = `REF ${dbOffset>=0?'+':''}${dbOffset.toFixed(0)} dB`;
        updateRefThumb();
      }
      if(s.tunerFreq !== null && s.tunerFreq !== undefined){
        tunerFreq = s.tunerFreq;
        document.getElementById('tunerReadout').textContent = tunerFreq.toFixed(3);
      }

      // Toggles
      if(s.autoFit){
        autoFit = true;
        document.getElementById('autoFitBtn').classList.add('on');
        document.getElementById('autoFitBar').setAttribute('opacity','1');
      }
      if(s.peakHold){
        peakHold = true;
        document.getElementById('peakHoldBtn').classList.add('on');
        document.getElementById('peakHoldBar').setAttribute('opacity','1');
      }

      // Antenna
      if(s.antenna){
        document.getElementById('antennaSelect').value = s.antenna;
      }

      // Volume
      if(s.volume !== undefined){
        document.getElementById('audioVol').value = s.volume;
        audioVolume = s.volume;
      }

      // Signal chain
      if(s.scChain && s.scChain.nodes && s.scChain.nodes.length){
        scBypassAllState = s.scBypass || false;
        document.getElementById('scBypassAll')?.classList.toggle('on', scBypassAllState);
        // Defer chain restore until after audio init
        window._pendingScRestore = s.scChain;
      }

      return true;
    }catch(e){ console.warn('state restore failed', e); return false; }
  }

  // Auto-save state on any meaningful change
  function setupAutosave(){
    // Save on spectrum interaction
    ['mouseup','wheel'].forEach(ev=>
      document.getElementById('specWrap').addEventListener(ev, ()=>setTimeout(saveState,200))
    );
    document.getElementById('antennaSelect').addEventListener('change', saveState);
    document.getElementById('audioVol').addEventListener('change', saveState);
    document.getElementById('peakHoldBtn').addEventListener('click', saveState);
    document.getElementById('autoFitBtn').addEventListener('click', saveState);
    document.getElementById('locLoadBtn').addEventListener('click', ()=>setTimeout(saveState,500));
    document.getElementById('locGpsBtn').addEventListener('click', ()=>setTimeout(saveState,500));
    // Save on band change
    document.querySelectorAll('.spec-band').forEach(el=>el.addEventListener('click', saveState));
    // Periodic save every 10s
    setInterval(saveState, 10000);
  }

  // ── Initial load ──────────────────────────────────────────────
  const hadState = restoreState();

  // Restore band view properly
  updateBand();
  drawGrid();

  setStatus(hadState ? 'RESTORING SESSION…' : 'NOISE FLOOR — SIMULATED · ENTER COORDINATES AND HIT LOAD FOR REAL STATIONS');

  setupAutosave();
  updateScMiniPreview();

  // ── Resume banner ─────────────────────────────────────────────
  const resumeBanner = document.getElementById('rfResumeBanner');
  if(hadState){
    resumeBanner.classList.remove('hidden');
    function doResume(){
      resumeBanner.classList.add('hidden');
      document.removeEventListener('click', onAnyClick);
      document.removeEventListener('keydown', onAnyClick);
      if(tunerFreq !== null) tuneAudio(tunerFreq);
    }
    function onAnyClick(e){
      // Don't intercept clicks on the banner itself (handled separately)
      if(e.target.closest && e.target.closest('#rfResumeBanner')) return;
      doResume();
    }
    resumeBanner.addEventListener('click', doResume);
    setTimeout(()=>{
      document.addEventListener('click', onAnyClick);
      document.addEventListener('keydown', onAnyClick);
    }, 100);
  }

  // Load stations from restored coords (or default)
  setTimeout(()=>{
    // Restore signal chain before audio init
    if(window._pendingScRestore){
      deserializeChain(window._pendingScRestore);
      delete window._pendingScRestore;
    }
    loadStations();
  }, 300);

})();
</script>
</body>
</html>