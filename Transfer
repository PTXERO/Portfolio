    oscBigPersistBuf = true;

    // Grid
    oscBigCtx.strokeStyle=`rgba(${hexToRgb(C.accent)},0.07)`;
    oscBigCtx.lineWidth=1;
    oscBigCtx.setLineDash([2,4]);
    for(let i=1;i<8;i++){
      oscBigCtx.beginPath();oscBigCtx.moveTo(0,H*i/8);oscBigCtx.lineTo(W,H*i/8);oscBigCtx.stroke();
      oscBigCtx.beginPath();oscBigCtx.moveTo(W*i/8,0);oscBigCtx.lineTo(W*i/8,H);oscBigCtx.stroke();
